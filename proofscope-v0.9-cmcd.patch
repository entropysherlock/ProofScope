+ "reference": "∀ (a : Int), a * a ≥ 0",
+ "lean": "∀ (a : Int), a * a ≥ 1",
+ "expected": "CLAIM_LEAN_STRONGER",
+ "expected_localized_at": [
+  1
+ ],
+ "annotation": "Claude (Anthropic), 2026-11-09; written and hashed before the CMCD engine freeze; synthetic, same author as the engine (not independent)"
+}
