new file mode 100644
index 0000000..bc1e9d9
--- /dev/null
+++ b/bench/sota4/failures.py
@@ -0,0 +1,104 @@
+"""SOTA-4 Task H: case-level cause analysis of the SOTA-3 CJCS development records that were not evaluated.
+
+Input: the unchanged SOTA-3 benchmark records (`runs/cjcs/t20/*.r0.json` from artifacts
+`sota3-runs-cjcs-<shard>` of run 42701174017, downloaded read-only by the SOTA-4 workflow) and, if present,
+their work directories. The original record and its original `evaluation_class` are copied verbatim into
+the report; the cause classification is added beside them and never replaces them.
+
+Cause classes (first that applies):
+  RESOURCE_CPU_BUDGET        status TIMEOUT_CPU: the whole-tree CPU budget (tier + startup allowance) ran out
+  RESOURCE_WALL              status TIMEOUT_WALL
+  RESOURCE_MEMORY            status OOM
+  ADAPTER_INPUT              the statement did not round-trip through the adapter (UNSUPPORTED_INPUT / NON_ELABORATING)
+  ADAPTER_ENVIRONMENT        adapter step failed outside the declaration (ADAPTER_ERROR / ADAPTER_*)
+  ENGINE_LAUNCH              LAUNCH_ERROR
+  ENGINE_CRASH               status ERROR / KILLED with no engine row
+  EXTRACTION                 engine row with reason "extraction failed"
+  CERTIFICATE_INFRASTRUCTURE certify_status INFRASTRUCTURE_ERROR / PREAMBLE_ERROR
+  SEARCH_INCOMPLETE          evaluated, ABSTAIN (not a failure; listed for completeness)
+  UNCLASSIFIED               anything else (reported with the log tail for manual review)
+
+For RESOURCE_* the last pipeline stage that started is reconstructed from the work directory (which Lean
+inputs exist): extract, stage-1 search, certify probe, certificate compile, witness readout.
+
+    python -m bench.sota4.failures --records <dir with *.r0.json> --out failures.json
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+STAGES = [("extract", "Assumptions_input.lean"), ("stage1_search", "*_s1Search.lean"), ("certify_probe", "*Probe.lean"),
+          ("certificate_compile", "build/ProofScopeCert/*.olean"), ("witness_read", "Witness_read.lean")]
+
+
+def last_stage(work: Path | None) -> str | None:
+    if not work or not work.exists():
+        return None
+    seen = None
+    for name, pat in STAGES:
+        if any(work.rglob(pat)):
+            seen = name
+    return seen
+
+
+def classify(rec: dict) -> str:
+    st = rec.get("status")
+    if st == "TIMEOUT_CPU":
+        return "RESOURCE_CPU_BUDGET"
+    if st == "TIMEOUT_WALL":
+        return "RESOURCE_WALL"
+    if st == "OOM":
+        return "RESOURCE_MEMORY"
+    if st in ("UNSUPPORTED_INPUT", "NON_ELABORATING"):
+        return "ADAPTER_INPUT"
+    if st and st.startswith("ADAPTER"):
+        return "ADAPTER_ENVIRONMENT"
+    if st == "LAUNCH_ERROR":
+        return "ENGINE_LAUNCH"
+    if rec.get("native_verdict") is None:
+        return "ENGINE_CRASH"
+    if rec.get("reason") == "extraction failed":
+        return "EXTRACTION"
+    if rec.get("certify_status") in ("INFRASTRUCTURE_ERROR", "PREAMBLE_ERROR"):
+        return "CERTIFICATE_INFRASTRUCTURE"
+    if rec.get("native_verdict") == "ABSTAIN":
+        return "SEARCH_INCOMPLETE"
+    return "UNCLASSIFIED"
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.sota4.failures")
+    ap.add_argument("--records", type=Path, required=True)
+    ap.add_argument("--work", type=Path, default=None, help="runs/work/cjcs/t20 if available")
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args(argv)
+    files = sorted(a.records.rglob("*.r0.json"))
+    rows, counts = [], {}
+    for f in files:
+        rec = json.loads(f.read_text())
+        ev = rec.get("evaluation_class")
+        if ev and ev.startswith("EVALUATED_") and ev != "EVALUATED_ABSTAIN":
+            continue
+        cid = rec.get("case_id") or f.name.split(".r0.json")[0]
+        work = (a.work / cid / "r0") if a.work else None
+        cause = classify(rec)
+        run = rec.get("run") or {}
+        rows.append({"case_id": cid, "original_status": rec.get("status"), "original_evaluation_class": ev,
+                     "cause": cause, "last_stage_started": last_stage(work), "cpu_tree_s": run.get("cpu_tree_s"),
+                     "limit_cpu_s": (rec.get("budget") or {}).get("limit_cpu_s"), "wall_s": run.get("wall_s"),
+                     "max_rss_mb": run.get("max_rss_mb"), "native_verdict": rec.get("native_verdict"),
+                     "reason": rec.get("reason"), "log_tail": (rec.get("log_tail") or "")[-800:],
+                     "original_record": rec})
+        counts[cause] = counts.get(cause, 0) + 1
+    rep = {"source_records": len(files), "not_evaluated_or_abstained": len(rows), "by_cause": counts, "cases": rows}
+    a.out.write_text(json.dumps(rep, ensure_ascii=False, indent=1))
+    print(json.dumps({k: rep[k] for k in ("source_records", "not_evaluated_or_abstained", "by_cause")}, indent=1))
+    for r in rows:
+        print(r["case_id"], r["original_evaluation_class"], r["cause"], r["last_stage_started"], r["cpu_tree_s"], r["limit_cpu_s"])
+    return 0 if files else 3
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/bench/sota4/integrity.py b/bench/sota4/integrity.py
new file mode 100644
index 0000000..58720e4
--- /dev/null
+++ b/bench/sota4/integrity.py
@@ -0,0 +1,153 @@
+"""Dataset integrity for SOTA-4 (repair of the SOTA-3 held-out checksum gate; see docs/sota4/INTEGRITY.md).
+
+Forensic finding (docs/sota4/INTEGRITY.md): the SOTA-3 gate hashed the raw concatenation of the 14 held-out
+files. The files were authored without a final newline; on the way into the repository exactly one `\\n` was
+appended to each of the 24 CJCS JSON files and to nothing else. The JSON values are unchanged. Removing that
+one byte from each held-out file reproduces the recorded digest bb8628b6… exactly.
+
+Repair (only what the evidence justifies):
+
+1. `canonical_bytes`: a file is committed by the SHA-256 of its *canonical JSON*:
+     * bytes must decode as UTF-8 (strict; a byte-order mark is rejected);
+     * parsed with Python's json module, rejecting duplicate object keys and NaN/Infinity;
+     * re-serialized with sorted keys, separators (",", ":"), ensure_ascii=False, allow_nan=False,
+       encoded as UTF-8.
+   Insignificant whitespace (including any line ending) does not change the digest; any change of a
+   key, value, type or array order does.
+2. A manifest commits the directory: the file pattern, every file name in sorted order with its canonical
+   digest, and a set digest over the ordered (name, digest) list. Verification fails on a missing file, an
+   unexpected additional file, a duplicated manifest entry, a manifest that is not in sorted order, invalid
+   JSON, or any digest mismatch.
+3. The manifest is not derived from the checkout: it was computed from the authenticated original bytes
+   (the SOTA-3 patch), and `legacy_raw_digest` ties it to the digest recorded in SOTA-3 before the first
+   run: stripping at most one trailing "\\n" per file must reproduce that digest (`--require-legacy`;
+   byte-level, so it holds for LF checkouts only; the canonical gate holds for any line ending).
+
+    python -m bench.sota4.integrity verify research/cjcs/core_heldout.MANIFEST.json
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+SCHEME = "proofscope-canonical-json-v1"
+
+
+class IntegrityError(ValueError):
+    pass
+
+
+def _no_dupes(pairs):
+    keys = [k for k, _ in pairs]
+    if len(keys) != len(set(keys)):
+        raise IntegrityError(f"duplicate object key in {keys}")
+    return dict(pairs)
+
+
+def _no_const(c):
+    raise IntegrityError(f"non-finite number {c} is not allowed")
+
+
+def canonical_bytes(raw: bytes) -> bytes:
+    if raw.startswith(b"\xef\xbb\xbf"):
+        raise IntegrityError("byte-order mark is not allowed")
+    try:
+        text = raw.decode("utf-8", errors="strict")
+    except UnicodeDecodeError as e:
+        raise IntegrityError(f"not UTF-8: {e}") from None
+    try:
+        obj = json.loads(text, object_pairs_hook=_no_dupes, parse_constant=_no_const)
+    except json.JSONDecodeError as e:
+        raise IntegrityError(f"invalid JSON: {e}") from None
+    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
+
+
+def file_digest(raw: bytes) -> str:
+    return hashlib.sha256(canonical_bytes(raw)).hexdigest()
+
+
+def set_digest(entries: list[dict]) -> str:
+    h = hashlib.sha256()
+    for e in entries:
+        h.update(f"{e['name']}\t{e['canonical_sha256']}\n".encode("utf-8"))
+    return h.hexdigest()
+
+
+def legacy_raw_digest(files: list[Path]) -> str:
+    """SOTA-3 gate digest (`cat dir/*.json | sha256sum`) after removing at most one trailing LF per file."""
+    h = hashlib.sha256()
+    for f in files:
+        b = f.read_bytes()
+        h.update(b[:-1] if b.endswith(b"\n") else b)
+    return h.hexdigest()
+
+
+def build_manifest(directory: Path, pattern: str, rel: str) -> dict:
+    files = sorted(directory.glob(pattern), key=lambda p: p.name)
+    entries = [{"name": f.name, "canonical_sha256": file_digest(f.read_bytes())} for f in files]
+    return {"scheme": SCHEME, "directory": rel, "pattern": pattern, "files": entries,
+            "set_digest": set_digest(entries)}
+
+
+def verify(manifest_path: Path, root: Path | None = None, require_legacy: bool = False) -> dict:
+    m = json.loads(Path(manifest_path).read_text(encoding="utf-8"))
+    if m.get("scheme") != SCHEME:
+        raise IntegrityError(f"unknown scheme {m.get('scheme')}")
+    root = Path(root) if root else Path(manifest_path).resolve().parents[2]
+    d = root / m["directory"]
+    names = [e["name"] for e in m["files"]]
+    if len(names) != len(set(names)):
+        raise IntegrityError("duplicated file entry in manifest")
+    if names != sorted(names):
+        raise IntegrityError("manifest file order is not the committed (sorted) order")
+    if set_digest(m["files"]) != m["set_digest"]:
+        raise IntegrityError("set digest does not match the manifest entries")
+    present = sorted(p.name for p in d.glob(m["pattern"]))
+    missing = sorted(set(names) - set(present))
+    extra = sorted(set(present) - set(names))
+    if missing:
+        raise IntegrityError(f"missing files: {missing}")
+    if extra:
+        raise IntegrityError(f"unexpected additional files: {extra}")
+    bad = []
+    for e in m["files"]:
+        got = file_digest((d / e["name"]).read_bytes())
+        if got != e["canonical_sha256"]:
+            bad.append({"name": e["name"], "expected": e["canonical_sha256"], "actual": got})
+    if bad:
+        raise IntegrityError(f"canonical digest mismatch: {bad}")
+    res = {"manifest": str(manifest_path), "files": len(names), "set_digest": m["set_digest"], "ok": True}
+    leg = m.get("legacy")
+    if leg:
+        got = legacy_raw_digest([d / n for n in names])
+        res["legacy_expected"], res["legacy_reconstructed"] = leg["raw_sha256"], got
+        res["legacy_match"] = got == leg["raw_sha256"]
+        # byte-level by construction: a CRLF checkout passes the canonical gate but not this one
+        if require_legacy and not res["legacy_match"]:
+            raise IntegrityError(f"legacy digest not reproduced: {got} != {leg['raw_sha256']}")
+    return res
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.sota4.integrity")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    v = sub.add_parser("verify")
+    v.add_argument("manifests", nargs="+", type=Path)
+    v.add_argument("--require-legacy", action="store_true",
+                   help="also require the byte-level SOTA-3 digest (LF checkouts; used in CI)")
+    a = ap.parse_args(argv)
+    ok = True
+    for mp in a.manifests:
+        try:
+            print(json.dumps(verify(mp, require_legacy=a.require_legacy)))
+        except IntegrityError as e:
+            ok = False
+            print(json.dumps({"manifest": str(mp), "ok": False, "error": str(e)}))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bench/sota4/measure.py b/bench/sota4/measure.py
new file mode 100644
index 0000000..27d4922
--- /dev/null
+++ b/bench/sota4/measure.py
@@ -0,0 +1,152 @@
+"""Evaluation A (SOTA-4): the frozen SOTA-3 CJCS engine against the SOTA-4 one-process engine, case by case,
+under the same accounting as the benchmark runner (bench/limits.py: whole-process-tree CPU, peak tree RSS).
+
+Each case is one fresh invocation `python -m <engine module> run <spec> --out <fresh dir> --jobs 1`, exactly
+the command shape of bench/adapters/proofscope.py:engine_cmd (so the extractor build is charged to every
+case, for both engines, as in the benchmark).
+
+Lean process counting does not trust the engines: a shim directory placed first on PATH wraps `lean`,
+`leanchecker` and the REPL; every launch appends its argv to a log. A launch that elaborates or replays a
+module counts as an environment load; `lean --version` / `--print-prefix` style queries do not.
+
+    python -m bench.sota4.measure --engine cjcs --engine cjcs4 --specs research/cjcs/core_dev/*.json \
+        --out evidence/perf --cpu-ceiling 900 --mem-mb 12000
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import statistics
+import sys
+from pathlib import Path
+
+from bench.limits import run_limited
+
+REPO = Path(__file__).resolve().parents[2]
+MODULES = {"cjcs": "proofscope.experimental.cjcs", "cjcs4": "proofscope.experimental.cjcs4"}
+NON_LOAD = ("--version", "--print-prefix", "--print-libdir", "--githash", "--help")
+
+
+def make_shims(shim: Path, log: Path) -> dict:
+    shim.mkdir(parents=True, exist_ok=True)
+    real = {"lean": shutil.which("lean"), "leanchecker": shutil.which("leanchecker"),
+            "repl": os.environ.get("PROOFSCOPE_REPL") or shutil.which("repl")}
+    for name, exe in real.items():
+        if not exe:
+            continue
+        p = shim / name
+        p.write_text(f'#!/bin/sh\nprintf "%s\\t%s\\n" "{name}" "$*" >> "{log}"\nexec "{exe}" "$@"\n')
+        p.chmod(0o755)
+    # keep the toolchain siblings (lake, ...) reachable for Toolchain.find()
+    lean_bin = Path(real["lean"]).resolve().parent
+    for f in lean_bin.iterdir():
+        if not (shim / f.name).exists():
+            (shim / f.name).symlink_to(f)
+    return real
+
+
+def count(log: Path) -> dict:
+    c = {"lean_elab": 0, "leanchecker": 0, "repl": 0, "queries": 0}
+    if log.exists():
+        for line in log.read_text().splitlines():
+            name, _, args = line.partition("\t")
+            if any(a in args.split() for a in NON_LOAD):
+                c["queries"] += 1
+            elif name == "lean":
+                c["lean_elab"] += 1
+            else:
+                c[name] += 1
+    c["environment_loads"] = c["lean_elab"] + c["leanchecker"] + c["repl"]
+    c["search_loads"] = None   # filled per engine below
+    return c
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.sota4.measure")
+    ap.add_argument("--engine", action="append", choices=sorted(MODULES), required=True)
+    ap.add_argument("--specs", nargs="+", required=True)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--cpu-ceiling", type=float, default=900.0)
+    ap.add_argument("--mem-mb", type=int, default=12000)
+    ap.add_argument("--prebuilt", action="store_true",
+                    help="build each engine's own Lean modules once, outside the per-case accounting, and copy them "
+                         "into every case (variant B; both engines are treated identically). Default (variant A) is "
+                         "the benchmark shape: every case builds them and is charged for it.")
+    a = ap.parse_args(argv)
+    out = a.out.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    records = []
+    pre = {}
+    if a.prebuilt:
+        from proofscope.toolchain import Toolchain
+        import importlib
+        for eng in a.engine:
+            d = out / "_prebuilt" / eng
+            if d.exists():
+                shutil.rmtree(d)
+            m = importlib.import_module(MODULES[eng])
+            b = (m.build if hasattr(m, "build") else importlib.import_module("proofscope.adelta12").build)(Toolchain.find(), d)
+            if not b["ok"]:
+                raise SystemExit(f"prebuild failed for {eng}: {b}")
+            pre[eng] = d
+    for eng in a.engine:
+        for spec in a.specs:
+            sp = Path(spec).resolve()
+            work = out / eng / sp.stem
+            if work.exists():
+                shutil.rmtree(work)
+            work.mkdir(parents=True)
+            if eng in pre:
+                shutil.copytree(pre[eng], work / "ps_out" / "build")
+            log = work / "launches.tsv"
+            shim = work / "shim"
+            real = make_shims(shim, log)
+            env = dict(os.environ)
+            env["PATH"] = f"{shim}{os.pathsep}{env.get('PATH', '')}"
+            if real.get("repl"):
+                env["PROOFSCOPE_REPL"] = str(shim / "repl")
+            cmd = [sys.executable, "-m", MODULES[eng], "run", str(sp), "--out", str(work / "ps_out"), "--jobs", "1"]
+            r = run_limited(cmd, a.cpu_ceiling, a.mem_mb, 2 * a.cpu_ceiling + 120, cwd=str(REPO), env=env, inputs=(str(sp),))
+            rowp = work / "ps_out" / "rows" / f"{sp.stem}.json"
+            row = json.loads(rowp.read_text()) if rowp.exists() else {}
+            c = count(log)
+            # build steps (extractor / search module) compile modules too; they are counted, not hidden
+            c["search_loads"] = (c["repl"] if eng == "cjcs4" else None)
+            spec_d = json.loads(sp.read_text())
+            rec = {"engine": eng, "variant": "B_prebuilt" if a.prebuilt else "A_benchmark_shape", "case": sp.stem, "status": r.status, "cpu_tree_s": round(r.cpu_tree_s, 3),
+                   "wall_s": round(r.wall_s, 3), "max_rss_mb": round(r.max_rss_mb, 1), "processes_seen": r.processes_seen,
+                   "launches": c, "verdict": row.get("verdict"), "direction": row.get("direction"),
+                   "expected": spec_d.get("expected"), "must_not_be": spec_d.get("must_not_be") or [],
+                   "certificates": sorted((row.get("certificates") or {}).keys()),
+                   "certify_status": row.get("certify_status"), "failure_class": row.get("failure_class"),
+                   "reason": row.get("reason"), "stats": row.get("stats"),
+                   "stderr_tail": (r.stderr or "")[-1500:] if r.status != "OK" else ""}
+            rec["exact"] = rec["verdict"] == rec["expected"] if rec["expected"] else None
+            rec["must_not_violation"] = rec["verdict"] in rec["must_not_be"]
+            records.append(rec)
+            print(json.dumps({k: rec[k] for k in ("engine", "case", "status", "cpu_tree_s", "verdict", "exact")}), flush=True)
+    summ = {}
+    for eng in a.engine:
+        rs = [r for r in records if r["engine"] == eng]
+        cpu = sorted(r["cpu_tree_s"] for r in rs)
+        summ[eng] = {"cases": len(rs), "ok_runs": sum(r["status"] == "OK" for r in rs),
+                     "exact": sum(bool(r["exact"]) for r in rs), "must_not_violations": sum(r["must_not_violation"] for r in rs),
+                     "certified_difference": sum(r["verdict"] == "CERTIFIED_LOGICAL_DIFFERENCE" for r in rs),
+                     "certified_equivalence": sum(r["verdict"] == "CERTIFIED_LOGICAL_EQUIVALENCE" for r in rs),
+                     "abstain": sum(r["verdict"] == "ABSTAIN" for r in rs),
+                     "inconclusive_or_none": sum(r["verdict"] in (None, "INCONCLUSIVE", "INCONSISTENT") for r in rs),
+                     "median_cpu_tree_s": statistics.median(cpu) if cpu else None,
+                     "max_cpu_tree_s": max(cpu) if cpu else None,
+                     "median_wall_s": statistics.median(r["wall_s"] for r in rs) if rs else None,
+                     "max_rss_mb": max((r["max_rss_mb"] for r in rs), default=None),
+                     "median_environment_loads": statistics.median(r["launches"]["environment_loads"] for r in rs) if rs else None}
+    (out / "records.json").write_text(json.dumps(records, ensure_ascii=False, indent=1))
+    (out / "summary.json").write_text(json.dumps(summ, indent=1))
+    print(json.dumps(summ, indent=1))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
