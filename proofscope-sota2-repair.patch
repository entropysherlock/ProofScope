+    ap.add_argument("--markdown", type=Path)
+    a = ap.parse_args(argv)
+    cases = [c["case_id"] for c in read_jsonl(a.cases)]
+    rep = {"tier_cpu_s": a.tier, "systems": {}}
+    for s in SYSTEMS:
+        recs, mans = {}, []
+        for p in a.runs.glob(f"**/{s}/t{a.tier}/*.json"):
