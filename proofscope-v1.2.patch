diff --git a/proofscope/models.py b/proofscope/models.py
new file mode 100644
index 0000000..f8965c4
--- /dev/null
+++ b/proofscope/models.py
@@ -0,0 +1,67 @@
+"""Countermodel-family registry and Mathlib proof portfolio (v1.2).
+
+A *family* is a concrete Mathlib carrier with sample elements. The engine never assumes a carrier has
+a structure: instance binders are filled with `inferInstance`, so a carrier lacking the required class
+simply fails to elaborate inside `first` and the next family is tried. Which carrier, instance and
+elements a certificate uses is read back from the kernel-checked proof term (`#proofscope_witness11`).
+
+Families (all with decidable equality, so element-wise refutations reduce by `decide`):
+  nonabelian groups   DihedralGroup 3, Equiv.Perm (Fin 3)
+  abelian groups      Multiplicative (ZMod 4)
+  non-total orders    Finset (Fin 2) (subset order), Bool × Bool (product order)
+  rings               ZMod 4 (zero divisors), ZMod 3 (field)
+  points              ℝ, ℤ, ℕ, sets of ℕ and ℝ, functions ℕ → ℕ, ℝ → ℝ, Empty → ℕ
+"""
+
+MATHLIB_CARRIERS = {
+    "DihedralGroup 3": {"vals": ["(DihedralGroup.r 1 : DihedralGroup 3)", "(DihedralGroup.sr 0 : DihedralGroup 3)",
+                                 "(1 : DihedralGroup 3)"],
+                        "op2": ["fun a b => a * b"], "op1": ["fun a => a⁻¹"], "rel": ["fun a b => a = b"]},
+    "Multiplicative (ZMod 4)": {"vals": ["(Multiplicative.ofAdd 1 : Multiplicative (ZMod 4))",
+                                         "(Multiplicative.ofAdd 2 : Multiplicative (ZMod 4))"],
+                                "op2": ["fun a b => a * b"], "op1": ["fun a => a⁻¹"], "rel": ["fun a b => a = b"]},
+    "Finset (Fin 2)": {"vals": ["(∅ : Finset (Fin 2))", "({0} : Finset (Fin 2))", "({1} : Finset (Fin 2))",
+                                "(Finset.univ : Finset (Fin 2))"],
+                       "op2": ["fun a b => a ∪ b"], "op1": ["fun a => a"], "rel": ["fun a b => a ⊆ b"]},
+    "ZMod 4": {"vals": ["(2 : ZMod 4)", "(0 : ZMod 4)", "(1 : ZMod 4)", "(3 : ZMod 4)"],
+               "op2": ["fun a b => a * b"], "op1": ["fun a => a"], "rel": ["fun a b => a = b"]},
+    "ZMod 3": {"vals": ["(0 : ZMod 3)", "(1 : ZMod 3)", "(2 : ZMod 3)"],
+               "op2": ["fun a b => a * b"], "op1": ["fun a => a"], "rel": ["fun a b => a = b"]},
+}
+
+MATHLIB_POINTS = {
+    "Set ℝ": ["({0} : Set ℝ)", "(∅ : Set ℝ)", "(Set.univ : Set ℝ)", "(Set.Icc 0 1 : Set ℝ)", "(Set.Ioo 0 1 : Set ℝ)"],
+    "ℕ → ℕ": ["fun _ => 0", "fun n => n", "fun n => n + 1", "fun n => n / 2"],
+    "ℝ → ℝ": ["fun _ => (-1 : ℝ)", "fun x => x", "fun _ => (0 : ℝ)", "fun x => x ^ 2"],
+    "Empty → ℕ": ["Empty.elim"],
+}
+
+# bounded proof portfolio for sufficiency / redundancy / unneeded assumptions (every alternative is
+# wrapped `(...; done)` by the caller and checked by the certify gate)
+MATHLIB_PROOF_PORTFOLIO = [
+    "(intros; positivity)", "(intros; nlinarith [sq_nonneg _])", "(intros; nlinarith)", "(intros; linarith)",
+    "(intros; norm_num)", "(intros; simp_all)", "(intros; omega)", "(intros; fun_prop)", "(intros; continuity)",
+    "(intros; exact Eq.symm ‹_›)", "(intros; exact mul_comm _ _)", "(intros; exact le_total _ _)",
+    "(intros; exact inf_sup_left _ _ _)", "(intros; exact ⟨1⟩)", "(intros; exact isOpen_univ)",
+    "(intros; exact Set.subset_univ _)", "(intros; exact Set.Subset.trans ‹_› ‹_›)", "(intros; exact Nat.dvd_trans ‹_› ‹_›)",
+    "(intros; exact Nat.Prime.two_le ‹_›)", "(intros; exact Function.Injective.comp ‹_› ‹_›)",
+    "(intros; exact Continuous.comp ‹_› ‹_›)", "(intros; exact Set.image_subset _ ‹_›)", "(intros; aesop)",
+    "(intros; group)", "(intros; ring_nf)", "(intros; exact le_trans ‹_› ‹_›)", "(intros; exact not_lt.mp ‹_›)",
+    "(intros; exact pow_pos ‹_› _)", "(intros; nlinarith [sq_nonneg (‹ℝ› - 1), sq_nonneg (‹ℝ› + 1), sq_nonneg ‹ℝ›])",
+    "(intros; exact le_antisymm ‹_› ‹_›)", "(intros; exact lt_asymm ‹_›)",
+]
+
+
+def MATHLIB_REFUTE(vals: list[str]) -> list[str]:
+    """Element-wise refutations of a universal claim and Mathlib-specific negations."""
+    out = ["(intro h; obtain ⟨x, hx⟩ := h 1; simp at hx)", "(intro h; obtain ⟨x, _⟩ := h 0; cases x)",
+           "(simp [Set.Nonempty])", "(exact not_isOpen_singleton 0)", "(exact isClosed_singleton)",
+           "(exact isCompact_empty)", "(exact continuous_const)", "(fun_prop)", "(exact Nat.prime_two)", "norm_num", "decide"]
+    for a in vals:
+        out += [f"(intro h; have := h {a}; norm_num at this)", f"(intro h; have := h {a}; simp at this)"]
+        for b in vals:
+            out += [f"(intro h; rcases h {a} {b} with h | h <;> revert h <;> decide)",
+                    f"(intro h; rcases h {a} {b} with h | h <;> simp [Finset.subset_iff] at h)",
+                    f"(intro h; have := h {a} {b}; revert this; decide)", f"(intro h; have := h {a} {b}; simp at this)",
+                    f"(intro h; have := h {a} {b}; norm_num at this)"]
+    return out
diff --git a/proofscope/v12.py b/proofscope/v12.py
new file mode 100644
index 0000000..63a8d22
--- /dev/null
+++ b/proofscope/v12.py
@@ -0,0 +1,110 @@
+"""ProofScope v1.2 runner: Assumption Delta v1.2 (`adelta12`) with sharding and a domain-coverage matrix.
+
+    python -m proofscope.v12 run SPEC.json ... --out DIR [--jobs N] [--shard i/n]
+    python -m proofscope.v12 aggregate DIR ... --out coverage.json [--markdown coverage.md]
+
+Coverage separates three things per domain: the statements **elaborate** (Lean accepted both and the
+telescope was extracted), the engine reached a **certified** decisive verdict (every decisive verdict is
+backed by kernel-checked certificates through the unchanged certify gate), and the verdict **matches**
+the pre-registered label. A verdict listed in a case's `must_not_be` is counted as **unsound**.
+Conclusion changes are reported as `CONCLUSION_ONLY_CHANGE` and are not scored as decisive here.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import defaultdict
+from pathlib import Path
+
+from . import adelta12 as AD
+
+DECISIVE = {"ASSUMPTION_EQUIVALENT", "LEAN_WEAKER_BY_ASSUMPTION", "LEAN_STRONGER_BY_ASSUMPTION",
+            "ASSUMPTION_INCOMPARABLE", "REFERENCE_NEEDS_ASSUMPTION", "LEAN_CLAIM_FALSE", "BOTH_CLAIMS_FALSE",
+            "INCLUSION_MINIMAL", "HAS_REDUNDANT_ASSUMPTIONS", "NO_ASSUMPTION_DELTA", "INCONSISTENT"}
+
+
+def matches(verdict: str, expected: str | None) -> bool:
+    if not expected:
+        return False
+    if expected.startswith("INCONCLUSIVE"):
+        return verdict.startswith("INCONCLUSIVE")
+    return verdict == expected
+
+
+def score_row(r: dict) -> dict:
+    v = r.get("verdict", "INCONCLUSIVE")
+    elaborated = r.get("reason") != "extraction failed"
+    return {"elaborated": elaborated, "certified": v in DECISIVE and v != "INCONSISTENT",
+            "conditional": v == "INCLUSION_MINIMAL_IF_THEOREM_HOLDS", "match": matches(v, r.get("expected")),
+            "unsound": v in (r.get("must_not_be") or []), "inconsistent": v == "INCONSISTENT"}
+
+
+def coverage(rows: list[dict]) -> dict:
+    by = defaultdict(lambda: defaultdict(int))
+    for r in rows:
+        s = score_row(r)
+        for key in (r.get("domain") or "?", "ALL"):
+            d = by[key]
+            d["cases"] += 1
+            for k, v in s.items():
+                d[k] += int(v)
+    return {"domains": {k: dict(v) for k, v in sorted(by.items())},
+            "unsound_cases": [r["id"] for r in rows if score_row(r)["unsound"]],
+            "rows": [{"id": r["id"], "domain": r.get("domain"), "expected": r.get("expected"),
+                      "verdict": r.get("verdict"), **score_row(r)} for r in rows]}
+
+
+def markdown(cov: dict) -> str:
+    out = ["| Domain | Cases | Elaborates | Certified decisive | Conditional | Matches label | Unsound |",
+           "|---|---|---|---|---|---|---|"]
+    for k, d in cov["domains"].items():
+        out.append(f"| {k} | {d['cases']} | {d.get('elaborated', 0)} | {d.get('certified', 0)} | "
+                   f"{d.get('conditional', 0)} | {d.get('match', 0)} | {d.get('unsound', 0)} |")
+    out.append("")
+    out.append("Unsound decisive verdicts: " + (", ".join(cov["unsound_cases"]) or "none"))
+    return "\n".join(out) + "\n"
+
+
+def _shard(paths: list[str], spec: str | None) -> list[str]:
+    if not spec:
+        return paths
+    i, n = (int(x) for x in spec.split("/"))
+    return [p for k, p in enumerate(sorted(paths)) if k % n == i]
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m proofscope.v12")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    r = sub.add_parser("run")
+    r.add_argument("specs", nargs="+")
+    r.add_argument("--out", type=Path, required=True)
+    r.add_argument("--jobs", type=int, default=1)
+    r.add_argument("--shard")
+    g = sub.add_parser("aggregate")
+    g.add_argument("dirs", nargs="+", type=Path)
+    g.add_argument("--out", type=Path, required=True)
+    g.add_argument("--markdown", type=Path)
+    a = ap.parse_args(argv)
+    if a.cmd == "run":
+        specs = _shard(a.specs, a.shard)
+        rc = AD.main(specs + ["--out", str(a.out), "--jobs", str(a.jobs)]) if specs else 0
+        return rc
+    rows = []
+    for d in a.dirs:
+        rows += [json.loads(p.read_text()) for p in sorted(d.rglob("rows/*.json"))]
+    seen = {}
+    for row in rows:
+        seen[row["id"]] = row
+    cov = coverage(list(seen.values()))
+    a.out.parent.mkdir(parents=True, exist_ok=True)
+    a.out.write_text(json.dumps(cov, indent=1, ensure_ascii=False))
+    md = markdown(cov)
+    if a.markdown:
+        a.markdown.write_text(md)
+    print(md)
+    return 1 if cov["unsound_cases"] else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
