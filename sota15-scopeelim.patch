diff --git a/experiments/sota15/gen_cases.py b/experiments/sota15/gen_cases.py
new file mode 100644
index 0000000..1ddc0d3
--- /dev/null
+++ b/experiments/sota15/gen_cases.py
@@ -0,0 +1,99 @@
+"""SOTA-15 evaluation cases: seeded random generator (frozen before the first engine run on them).
+
+Writes native ScopeElim specs (bounded Horn, symbolic Horn, one-occurrence function) and
+ClaimDelta-format cases. No expected labels are written here: ground truth comes from
+`oracle.py` (exhaustive model enumeration, bounded Horn only) and `z3_check.py` (independent solver).
+Terms avoid truncated subtraction so the Z3 encoding over the integers is exact.
+"""
+import json
+import random
+from pathlib import Path
+
+SEED = 20261110
+OUT = Path(__file__).resolve().parent / "cases"
+
+
+def bounded(rng, i):
+    shape = rng.choices(["S", "ST", "E"], [0.6, 0.25, 0.15])[0]
+    if shape == "E":
+        syms, n = {"E": 2}, 3
+        t = ["x", "y", "0", "1", "2"]
+        atom = lambda: ["E", [rng.choice(t), rng.choice(t)]]
+        vars_ = lambda: [["x", str(n)], ["y", rng.choice([str(n), "x + 1"])]]
+        guards = ["True", "True", "x < y", "x ≠ y", "x = y"]
+    else:
+        syms = {"S": 1} if shape == "S" else {"S": 1, "T": 1}
+        n = rng.choice([3, 4, 5]) if shape == "S" else 3
+        t = ["x", "x", "x + 1", "x + 2", "0", "1", "2 * x", "x % 2", "x / 2"]
+        atom = lambda: [rng.choice(list(syms)), [rng.choice(t)]]
+        vars_ = lambda: [["x", rng.choice([str(n), str(n), str(n - 1), "0"]) if rng.random() < 0.15 else str(n)]]
+        guards = ["True", "True", "True", "x % 2 = 0", "1 ≤ x", "x < 2", "x ≠ 1", "False"]
+
+    def clause(local_ok):
+        c = {"vars": vars_(), "guard": rng.choice(guards),
+             "prems": [atom() for _ in range(rng.choice([0, 1, 1, 1, 2]))], "concl": atom()}
+        if local_ok and rng.random() < 0.2:
+            c["locals"] = [{"prems": [atom()], "concl": atom()}]
+        return c
+    ref = [clause(False) for _ in range(rng.choice([1, 1, 2, 3]))]
+    if rng.random() < 0.3:                     # adversarial: formal is a re-use or a perturbation of a rule
+        base = json.loads(json.dumps(rng.choice(ref)))
+        if rng.random() < 0.5 and base["prems"]:
+            base["concl"] = atom()
+        frm = [base]
+    else:
+        frm = [clause(True) for _ in range(rng.choice([1, 1, 2]))]
+    return {"id": f"hb{i:03d}", "kind": "horn", "symbols": syms, "reference": ref, "formal": frm}
+
+
+def symbolic(rng, i):
+    g = ["True", "True", "True", "1 ≤ x", "x % 2 = 0", "2 ≤ x"]
+    t = lambda: rng.choice(["x", "x", "x + 1", "x + 2", "x + 3", "0", "1"])
+
+    def clause():
+        return {"vars": [["x", None]], "guard": rng.choice(g),
+                "prems": [["S", [t()]] for _ in range(rng.choice([0, 1, 1, 1, 1, 2]))], "concl": ["S", [t()]]}
+    return {"id": f"hs{i:03d}", "kind": "horn", "symbols": {"S": 1},
+            "reference": [clause() for _ in range(rng.choice([1, 1, 2]))], "formal": [clause()]}
+
+
+_G = ["True", "True", "True", "1 ≤ n", "n % 2 = 0", "n < 3", "2 ≤ n"]
+_A = ["n", "n", "n", "n + 1", "n + 2", "2 * n", "0", "3"]
+_R = ["n < w", "n ≤ w", "w < n", "w ≤ n", "w ≤ n + 2", "w = 0", "w = n", "w ≠ n", "n < w ∨ n = 2",
+      "w % 2 = 0", "w + n ≥ 3", "w < 5", "n + 1 < w", "2 * n ≤ w"]
+
+
+def func(rng, i):
+    c = lambda: {"var": "n", "guard": rng.choice(_G), "arg": rng.choice(_A), "rel": rng.choice(_R)}
+    return {"id": f"fn{i:03d}", "kind": "func", "reference": c(), "formal": c()}
+
+
+def claimdelta(rng, i):
+    if rng.random() < 0.6:                     # once-occurring symbol: 2 ^ (arg)
+        def side():
+            a = rng.choice(["n", "n", "n + 1", "n + 2", "2 * n"])
+            r = rng.choice([x for x in _R if "w" in x])
+            return rng.choice(_G), r.replace("w", f"2 ^ ({a})")
+    else:                                      # definite clauses over the atom `Nat.gcd t 6 = 1`
+        def side():
+            at = lambda: f"Nat.gcd ({rng.choice(['n', 'n', 'n + 1', 'n + 2', 'n + 3'])}) 6 = 1"
+            h = at() if rng.random() < 0.7 else f"{rng.choice(['1 ≤ n', 'n % 2 = 0'])} ∧ {at()}"
+            return h, at()
+    (rh, rc), (lh, lc) = side(), side()
+    return {"id": f"cd{i:03d}", "family": "sota15", "split": "sota15_eval", "binders": [["n", "Nat"]],
+            "ref_hyp": rh, "ref_concl": rc, "lean_hyp": lh, "lean_concl": lc}
+
+
+def main():
+    rng = random.Random(SEED)
+    for name, gen, n in [("horn_bounded", bounded, 60), ("horn_symbolic", symbolic, 30), ("func", func, 40),
+                         ("claimdelta", claimdelta, 30)]:
+        d = OUT / name
+        d.mkdir(parents=True, exist_ok=True)
+        for i in range(n):
+            c = gen(rng, i)
+            (d / f"{c['id']}.json").write_text(json.dumps(c, ensure_ascii=False, indent=1) + "\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/sota15/oracle.py b/experiments/sota15/oracle.py
new file mode 100644
index 0000000..62a0279
--- /dev/null
+++ b/experiments/sota15/oracle.py
@@ -0,0 +1,64 @@
+"""Ground truth for bounded Horn specs by exhaustive enumeration of interpretations.
+
+Independent of the engine's saturation: for each direction it enumerates every interpretation of the
+predicate symbols on the finite universe `[0..M]^k` (M = largest term value that occurs) and evaluates
+the two schemas directly. Shares only the expression parser/evaluator with the engine.
+"""
+import itertools
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from proofscope.scope_expr import evaluate, parse  # noqa: E402
+
+
+def _envs(c):
+    out = [dict()]
+    for n, b in c.get("vars", []):
+        out = [{**e, n: v} for e in out for v in range(evaluate(parse(str(b)), e))]
+    return out
+
+
+def _atoms(c, env):
+    al = list(c.get("prems", [])) + [c["concl"]]
+    for l in c.get("locals", []):
+        al += l["prems"] + [l["concl"]]
+    return [(a[0], tuple(evaluate(parse(str(t)), env) for t in a[1])) for a in al]
+
+
+def _holds(c, env, I):
+    at = lambda a: (a[0], tuple(evaluate(parse(str(t)), env) for t in a[1])) in I
+    if not evaluate(parse(c.get("guard", "True")), env):
+        return True
+    if not all(at(a) for a in c.get("prems", [])):
+        return True
+    for l in c.get("locals", []):
+        if all(at(a) for a in l["prems"]) and not at(l["concl"]):
+            return True
+    return at(c["concl"])
+
+
+def truth(spec, limit=20):
+    cl = spec["reference"] + spec["formal"]
+    used = {a for c in cl for e in _envs(c) for a in _atoms(c, e)}
+    m = max([v for a in used for v in a[1]] + [0])
+    universe = [(s, t) for s, k in spec["symbols"].items() for t in itertools.product(range(m + 1), repeat=k)]
+    universe = [a for a in universe if a in used]          # atoms never mentioned cannot matter
+    if len(universe) > limit:
+        return None
+    sat = lambda side, I: all(_holds(c, e, I) for c in spec[side] for e in _envs(c))
+    fwd = bwd = True
+    for bits in itertools.product([False, True], repeat=len(universe)):
+        I = {a for a, b in zip(universe, bits) if b}
+        r, f = sat("reference", I), sat("formal", I)
+        fwd &= (not r) or f
+        bwd &= (not f) or r
+        if not fwd and not bwd:
+            break
+    return {"fwd": "ENTAILS" if fwd else "SEPARATED", "bwd": "ENTAILS" if bwd else "SEPARATED", "atoms": len(universe)}
+
+
+if __name__ == "__main__":
+    for p in sys.argv[1:]:
+        print(p, truth(json.loads(Path(p).read_text())))
diff --git a/experiments/sota15/run_eval.py b/experiments/sota15/run_eval.py
new file mode 100644
index 0000000..1062cc9
--- /dev/null
+++ b/experiments/sota15/run_eval.py
@@ -0,0 +1,67 @@
+"""Run the frozen SOTA-15 cases through the ScopeElim engine, the exhaustive oracle and Z3."""
+import json
+import sys
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parents[1]))
+sys.path.insert(0, str(HERE))
+from proofscope import scopeelim as se  # noqa: E402
+from proofscope.toolchain import Toolchain  # noqa: E402
+import oracle  # noqa: E402
+import z3_check  # noqa: E402
+
+
+def main(out: Path, jobs: int):
+    base = Toolchain.find()
+    assert se.build_lib(base, out / "lib")["ok"]
+    tc = se.lib_toolchain(base, out / "lib")
+    rows = []
+    for group in ("horn_bounded", "horn_symbolic", "func"):
+        specs = [json.loads(p.read_text()) for p in sorted((HERE / "cases" / group).glob("*.json"))]
+
+        def one(spec):
+            r = se.compare(spec, tc, out / "lib", out / "work" / spec["id"])
+            r["group"] = group
+            r["oracle"] = oracle.truth(spec) if group == "horn_bounded" else None
+            t0 = time.time()
+            try:
+                r["z3"] = z3_check.directions(spec)
+            except Exception as e:                      # noqa: BLE001
+                r["z3"] = {"error": str(e)[:200]}
+            r["z3_seconds"] = round(time.time() - t0, 2)
+            return r
+        with ThreadPoolExecutor(max_workers=jobs) as ex:
+            rows += list(ex.map(one, specs))
+    (out / "native_results.json").write_text(json.dumps({"rows": rows}, indent=1, ensure_ascii=False, default=str))
+    summary = {}
+    for g in ("horn_bounded", "horn_symbolic", "func"):
+        rs = [r for r in rows if r["group"] == g]
+        dirs = [(r, d) for r in rs for d in ("fwd", "bwd")]
+        st = lambda r, d: (r.get("directions") or {}).get(d, "UNKNOWN")
+        s = {"cases": len(rs), "decisive_verdicts": sum(r["verdict"] not in ("INCONCLUSIVE", "INCONSISTENT") for r in rs),
+             "inconsistent": sum(r["verdict"] == "INCONSISTENT" for r in rs),
+             "directions": len(dirs), "directions_certified": sum(st(r, d) != "UNKNOWN" for r, d in dirs),
+             "median_seconds": sorted(r["seconds"] for r in rs)[len(rs) // 2],
+             "max_seconds": max(r["seconds"] for r in rs),
+             "median_certificate_bytes": sorted(r.get("certificate_bytes", 0) for r in rs)[len(rs) // 2],
+             "max_certificate_bytes": max(r.get("certificate_bytes", 0) for r in rs)}
+        if g == "horn_bounded":
+            with_truth = [(r, d) for r, d in dirs if r["oracle"]]
+            s["oracle_directions"] = len(with_truth)
+            s["wrong_vs_oracle"] = [(r["id"], d) for r, d in with_truth if st(r, d) not in ("UNKNOWN", r["oracle"][d])]
+            s["abstained_vs_oracle"] = sum(st(r, d) == "UNKNOWN" for r, d in with_truth)
+        z = [(r, d) for r, d in dirs if r["z3"].get(d) in ("ENTAILS", "SEPARATED")]
+        s["z3_decided_directions"] = len(z)
+        s["z3_disagreements"] = [(r["id"], d) for r, d in z if st(r, d) not in ("UNKNOWN", r["z3"][d])]
+        s["engine_only"] = sum(st(r, d) != "UNKNOWN" and r["z3"].get(d) not in ("ENTAILS", "SEPARATED") for r, d in dirs)
+        s["z3_only"] = sum(st(r, d) == "UNKNOWN" for r, d in z)
+        summary[g] = s
+    (out / "native_summary.json").write_text(json.dumps(summary, indent=1))
+    print(json.dumps(summary, indent=1))
+
+
+if __name__ == "__main__":
+    main(Path(sys.argv[1]).resolve(), int(sys.argv[2]) if len(sys.argv) > 2 else 4)
diff --git a/experiments/sota15/z3_check.py b/experiments/sota15/z3_check.py
new file mode 100644
index 0000000..e73fa10
--- /dev/null
+++ b/experiments/sota15/z3_check.py
@@ -0,0 +1,122 @@
+"""Independent comparison with Z3: is `reference → formal` valid for every interpretation of the
+abstracted symbol (uninterpreted predicate or function over the naturals)?  `unsat` of
+`R ∧ ¬F` means ENTAILS, `sat` means SEPARATED, anything else UNKNOWN."""
+import json
+import sys
+from pathlib import Path
+
+import z3
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from proofscope.scope_expr import parse  # noqa: E402
+
+TIMEOUT_MS = 8000
+
+
+def enc(a, env):
+    k = a[0]
+    if k == "num":
+        return z3.IntVal(a[1])
+    if k == "var":
+        return env[a[1]]
+    if k == "true":
+        return z3.BoolVal(True)
+    if k == "false":
+        return z3.BoolVal(False)
+    if k == "bin":
+        x, y = enc(a[2], env), enc(a[3], env)
+        if a[1] == "^" or (a[1] == "app"):
+            raise ValueError("opaque")
+        return {"+": x + y, "*": x * y, "/": x / y, "%": x % y}[a[1]]
+    if k == "app":
+        return env[a[1]](*[enc(x, env) for x in a[2]])
+    if k == "cmp":
+        x, y = enc(a[2], env), enc(a[3], env)
+        return {"=": x == y, "≠": x != y, "<": x < y, "≤": x <= y, ">": x > y, "≥": x >= y}[a[1]]
+    if k == "and":
+        return z3.And(enc(a[1], env), enc(a[2], env))
+    if k == "or":
+        return z3.Or(enc(a[1], env), enc(a[2], env))
+    if k == "imp":
+        return z3.Implies(enc(a[1], env), enc(a[2], env))
+    if k == "not":
+        return z3.Not(enc(a[1], env))
+    raise ValueError(k)
+
+
+def _forall(vs, body):
+    return z3.ForAll(vs, body) if vs else body
+
+
+def horn_side(clauses, syms):
+    out = []
+    for c in clauses:
+        vs = [z3.Int(n) for n, _ in c.get("vars", [])]
+        env = {**syms, **{str(v): v for v in vs}}
+        at = lambda a: syms[a[0]](*[enc(parse(str(t)), env) for t in a[1]])
+        hyp = [v >= 0 for v in vs]
+        hyp += [v < enc(parse(str(b)), env) for v, (_, b) in zip(vs, c.get("vars", [])) if b is not None]
+        hyp += [enc(parse(c.get("guard", "True")), env)] + [at(a) for a in c.get("prems", [])]
+        hyp += [z3.Implies(z3.And([at(a) for a in l["prems"]]), at(l["concl"])) for l in c.get("locals", [])]
+        out.append(_forall(vs, z3.Implies(z3.And(hyp), at(c["concl"]))))
+    return z3.And(out) if out else z3.BoolVal(True)
+
+
+def func_side(c, f):
+    n = z3.Int(c["var"])
+    w = f(enc(parse(c["arg"]), {c["var"]: n}))
+    return z3.ForAll([n], z3.Implies(z3.And(n >= 0, enc(parse(c.get("guard", "True")), {c["var"]: n})),
+                                     enc(parse(c["rel"]), {c["var"]: n, "w": w})))
+
+
+def check(a, b, extra=()):
+    s = z3.Solver()
+    s.set("timeout", TIMEOUT_MS)
+    s.add(*extra)
+    s.add(a, z3.Not(b))
+    r = s.check()
+    return {"unsat": "ENTAILS", "sat": "SEPARATED"}.get(str(r), "UNKNOWN")
+
+
+def directions(spec):
+    if spec["kind"] == "horn":
+        syms = {s: z3.Function(s, *([z3.IntSort()] * k), z3.BoolSort()) for s, k in spec["symbols"].items()}
+        R, F, extra = horn_side(spec["reference"], syms), horn_side(spec["formal"], syms), ()
+    else:
+        f = z3.Function("f", z3.IntSort(), z3.IntSort())
+        z = z3.Int("z")
+        R, F = func_side(spec["reference"], f), func_side(spec["formal"], f)
+        extra = (z3.ForAll([z], f(z) >= 0),)
+    return {"fwd": check(R, F, extra), "bwd": check(F, R, extra)}
+
+
+def claimdelta_directions(spec):
+    """Schematic comparison of a ClaimDelta case with its single opaque binary symbol uninterpreted."""
+    g = z3.Function("g", z3.IntSort(), z3.IntSort(), z3.IntSort())
+    n = z3.Int("n")
+
+    def e(a, env):
+        if a[0] == "bin" and a[1] == "^":
+            return g(e(a[2], env), e(a[3], env))
+        if a[0] == "app":
+            return g(*[e(x, env) for x in a[2]])
+        if a[0] in ("bin", "cmp"):
+            x, y = e(a[2], env), e(a[3], env)
+            return {"+": lambda: x + y, "*": lambda: x * y, "/": lambda: x / y, "%": lambda: x % y, "=": lambda: x == y,
+                    "≠": lambda: x != y, "<": lambda: x < y, "≤": lambda: x <= y, ">": lambda: x > y, "≥": lambda: x >= y}[a[1]]()
+        if a[0] in ("and", "or"):
+            return (z3.And if a[0] == "and" else z3.Or)(e(a[1], env), e(a[2], env))
+        if a[0] == "not":
+            return z3.Not(e(a[1], env))
+        return enc(a, env)
+    side = lambda h, c: z3.ForAll([n], z3.Implies(z3.And(n >= 0, e(parse(spec[h]), {"n": n})), e(parse(spec[c]), {"n": n})))
+    R, F = side("ref_hyp", "ref_concl"), side("lean_hyp", "lean_concl")
+    a, b = z3.Ints("a b")
+    extra = (z3.ForAll([a, b], g(a, b) >= 0),)
+    return {"fwd": check(R, F, extra), "bwd": check(F, R, extra)}
+
+
+if __name__ == "__main__":
+    for p in sys.argv[1:]:
+        s = json.loads(Path(p).read_text())
+        print(p, claimdelta_directions(s) if "binders" in s else directions(s))
diff --git a/lean/ProofScope/HornFin.lean b/lean/ProofScope/HornFin.lean
new file mode 100644
index 0000000..598c44c
--- /dev/null
+++ b/lean/ProofScope/HornFin.lean
@@ -0,0 +1,185 @@
+/-!
+# HornFin: a verified decision procedure for ground definite-clause entailment (SOTA-15)
+
+Core Lean 4 only. Atoms are elements of a type with decidable equality; a rule is a finite body and
+a head. `closure rules prem` saturates `prem` under `rules`. Proved here:
+
+* **termination**: `sat` is structurally recursive on its fuel, and `closure` supplies fuel
+  `rules.length`, which `sat_closed` shows is enough (each productive round retires a rule);
+* **soundness** (`closure_sound`): everything in the closure is derivable;
+* **completeness** (`closure_complete`): everything derivable is in the closure;
+* **exactness** (`entails_iff`): uniform entailment over *all* predicates `σ : α → Prop` holds iff
+  the goal is in the closure, so the relation is decidable (`instDecidableEntails`).
+-/
+namespace ProofScope.HornFin
+
+variable {α : Type} [DecidableEq α]
+
+/-- A ground definite clause: body atoms and head atom. -/
+abbrev Rule (α : Type) := List α × α
+
+/-- Derivability from premises `prem` under `rules`. -/
+inductive Der (rules : List (Rule α)) (prem : List α) : α → Prop
+  | base {a : α} : a ∈ prem → Der rules prem a
+  | step {r : Rule α} : r ∈ rules → (∀ b, b ∈ r.1 → Der rules prem b) → Der rules prem r.2
+
+/-- The rule's body is contained in `S`. -/
+def app (S : List α) (r : Rule α) : Bool := r.1.all (fun b => decide (b ∈ S))
+
+theorem app_iff {S : List α} {r : Rule α} : app S r = true ↔ ∀ b, b ∈ r.1 → b ∈ S := by
+  simp [app]
+
+/-- Saturation: fire every applicable rule, retire the fired rules, repeat. -/
+def sat : Nat → List (Rule α) → List α → List α
+  | 0, _, S => S
+  | fuel + 1, rules, S =>
+    if (rules.filter (app S)).isEmpty then S
+    else sat fuel (rules.filter (fun r => !app S r)) (S ++ (rules.filter (app S)).map Prod.snd)
+
+/-- The least model of `rules` containing `prem`, as a list. -/
+def closure (rules : List (Rule α)) (prem : List α) : List α := sat rules.length rules prem
+
+theorem sat_mono (fuel : Nat) (rules : List (Rule α)) (S : List α) :
+    ∀ a, a ∈ S → a ∈ sat fuel rules S := by
+  induction fuel generalizing rules S with
+  | zero => intro a h; exact h
+  | succ n ih =>
+    intro a h
+    unfold sat
+    split
+    · exact h
+    · exact ih _ _ a (List.mem_append_left _ h)
+
+theorem sat_sound (all : List (Rule α)) (prem : List α) (fuel : Nat) (rules : List (Rule α))
+    (S : List α) (hr : ∀ r, r ∈ rules → r ∈ all) (hS : ∀ a, a ∈ S → Der all prem a) :
+    ∀ a, a ∈ sat fuel rules S → Der all prem a := by
+  induction fuel generalizing rules S with
+  | zero => intro a h; exact hS a h
+  | succ n ih =>
+    intro a h
+    unfold sat at h
+    split at h
+    · exact hS a h
+    · refine ih _ _ (fun r hr' => hr r (List.mem_filter.1 hr').1) ?_ a h
+      intro b hb
+      rcases List.mem_append.1 hb with hb | hb
+      · exact hS b hb
+      · obtain ⟨r, hrf, rfl⟩ := List.mem_map.1 hb
+        have hf := List.mem_filter.1 hrf
+        exact Der.step (hr r hf.1) (fun c hc => hS c (app_iff.1 hf.2 c hc))
+
+theorem filter_length_lt {β : Type} (p : β → Bool) (l : List β) {x : β} (hx : x ∈ l)
+    (hp : p x = false) : (l.filter p).length < l.length := by
+  induction l with
+  | nil => cases hx
+  | cons y ys ih =>
+    rcases List.mem_cons.1 hx with rfl | h
+    · rw [List.filter_cons_of_neg (by simp [hp])]
+      exact Nat.lt_succ_of_le (List.length_filter_le _ _)
+    · by_cases hy : p y = true
+      · rw [List.filter_cons_of_pos hy]; exact Nat.succ_lt_succ (ih h)
+      · rw [List.filter_cons_of_neg hy]; exact Nat.lt_succ_of_lt (ih h)
+
+/-- With enough fuel the result is closed under every rule still pending. -/
+theorem sat_closed (fuel : Nat) (rules : List (Rule α)) (S : List α) (hlen : rules.length ≤ fuel) :
+    ∀ r, r ∈ rules → (∀ b, b ∈ r.1 → b ∈ sat fuel rules S) → r.2 ∈ sat fuel rules S := by
+  induction fuel generalizing rules S with
+  | zero =>
+    intro r hr
+    have : rules = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.1 hlen)
+    subst this; cases hr
+  | succ n ih =>
+    intro r hr hbody
+    unfold sat at hbody ⊢
+    split
+    · rename_i hemp
+      simp only [hemp, ↓reduceIte] at hbody
+      have : r ∈ rules.filter (app S) := List.mem_filter.2 ⟨hr, app_iff.2 hbody⟩
+      rw [List.isEmpty_iff.1 hemp] at this; cases this
+    · rename_i hne
+      simp only [hne] at hbody
+      by_cases happ : app S r = true
+      · apply sat_mono
+        exact List.mem_append_right _ (List.mem_map.2 ⟨r, List.mem_filter.2 ⟨hr, happ⟩, rfl⟩)
+      · refine ih _ _ ?_ r (List.mem_filter.2 ⟨hr, by simp [happ]⟩) hbody
+        have hex : ∃ x, x ∈ rules.filter (app S) := by
+          cases hf : rules.filter (app S) with
+          | nil => rw [hf] at hne; exact absurd rfl hne
+          | cons x _ => exact ⟨x, List.mem_cons_self⟩
+        obtain ⟨x, hx⟩ := hex
+        have hx' := List.mem_filter.1 hx
+        have := filter_length_lt (fun r => !app S r) rules hx'.1 (by simp [hx'.2])
+        omega
+
+theorem closure_sound (rules : List (Rule α)) (prem : List α) :
+    ∀ a, a ∈ closure rules prem → Der rules prem a :=
+  sat_sound rules prem _ rules prem (fun _ h => h) (fun _ h => Der.base h)
+
+theorem closure_complete (rules : List (Rule α)) (prem : List α) :
+    ∀ a, Der rules prem a → a ∈ closure rules prem := by
+  intro a d
+  induction d with
+  | base h => exact sat_mono _ _ _ _ h
+  | step hr _ ih => exact sat_closed _ rules prem (Nat.le_refl _) _ hr ih
+
+/-- A predicate satisfies every rule. -/
+def Models (rules : List (Rule α)) (σ : α → Prop) : Prop :=
+  ∀ r, r ∈ rules → (∀ b, b ∈ r.1 → σ b) → σ r.2
+
+/-- Uniform entailment: every model of the rules containing the premises contains the goal. -/
+def Entails (rules : List (Rule α)) (prem : List α) (g : α) : Prop :=
+  ∀ σ : α → Prop, Models rules σ → (∀ p, p ∈ prem → σ p) → σ g
+
+omit [DecidableEq α] in
+theorem der_least {rules : List (Rule α)} {prem : List α} {σ : α → Prop} (hσ : Models rules σ)
+    (hp : ∀ p, p ∈ prem → σ p) {a : α} (d : Der rules prem a) : σ a := by
+  induction d with
+  | base hb => exact hp _ hb
+  | step hr _ ih => exact hσ _ hr ih
+
+/-- **Exactness.** Uniform entailment over all predicates is membership in the computed closure. -/
+theorem entails_iff (rules : List (Rule α)) (prem : List α) (g : α) :
+    Entails rules prem g ↔ g ∈ closure rules prem := by
+  constructor
+  · intro h
+    exact closure_complete rules prem g
+      (h (Der rules prem) (fun _ hr hb => Der.step hr hb) (fun _ hp => Der.base hp))
+  · intro h σ hσ hp
+    exact der_least hσ hp (closure_sound rules prem g h)
+
+instance instDecidableEntails (rules : List (Rule α)) (prem : List α) (g : α) :
+    Decidable (Entails rules prem g) :=
+  decidable_of_iff _ (entails_iff rules prem g).symm
+
+/-- The closure is itself a separating model whenever the goal is outside it. -/
+theorem canonical_separation (rules : List (Rule α)) (prem : List α) (g : α)
+    (h : g ∉ closure rules prem) :
+    Models rules (· ∈ closure rules prem) ∧ (∀ p, p ∈ prem → p ∈ closure rules prem) ∧
+      g ∉ closure rules prem :=
+  ⟨fun _ hr hb => sat_closed _ rules prem (Nat.le_refl _) _ hr hb, sat_mono _ _ _, h⟩
+
+/-- Hypothetical premises (a nested implication in the formal claim) are extra rules. -/
+theorem entails_local (rules loc : List (Rule α)) (prem : List α) (g : α) :
+    (∀ σ : α → Prop, Models rules σ → Models loc σ → (∀ p, p ∈ prem → σ p) → σ g) ↔
+      g ∈ closure (rules ++ loc) prem := by
+  rw [← entails_iff]
+  constructor
+  · intro h σ hσ hp
+    exact h σ (fun r hr => hσ r (List.mem_append_left _ hr))
+      (fun r hr => hσ r (List.mem_append_right _ hr)) hp
+  · intro h σ h1 h2 hp
+    exact h σ (fun r hr => (List.mem_append.1 hr).elim (h1 r) (h2 r)) hp
+
+/-! Worked instances, decided by evaluation of the verified procedure. -/
+example : Entails [([0], 1), ([1], 2)] [0] (2 : Nat) := by decide
+example : ¬ Entails [([0], 2), ([2], 4)] [0] (1 : Nat) := by decide
+example : Entails [([0, 1], 2), ([], 1)] [0] (2 : Nat) := by decide
+
+end ProofScope.HornFin
+
+#print axioms ProofScope.HornFin.closure_sound
+#print axioms ProofScope.HornFin.closure_complete
+#print axioms ProofScope.HornFin.sat_closed
+#print axioms ProofScope.HornFin.entails_iff
+#print axioms ProofScope.HornFin.canonical_separation
+#print axioms ProofScope.HornFin.entails_local
diff --git a/lean/ProofScope/MonoElim.lean b/lean/ProofScope/MonoElim.lean
new file mode 100644
index 0000000..ce198b9
--- /dev/null
+++ b/lean/ProofScope/MonoElim.lean
@@ -0,0 +1,156 @@
+/-!
+# MonoElim: elimination of a function symbol under the monotonicity law (SOTA-15, Challenge D)
+
+Core Lean 4 only. SOTA-14 Theorem B eliminates a function symbol that occurs once and is otherwise
+unconstrained. Monotonicity `a ≤ b → f a ≤ f b` uses the symbol twice, so Theorem B does not apply.
+This file shows that elimination survives the law when the reference constraints are *convex*
+(a lower bound `l z ≤ f z` and an optional upper bound `f z ≤ u z` at each argument):
+
+* `mono_extension`: a monotone function meeting all bounds and passing through `(z₀, w₀)` exists
+  iff three *two-point* conditions hold. The witness is canonical (the least such function).
+* `mono_elim`: for a feasible reference, uniform entailment over monotone functions of a claim in
+  which the symbol occurs once is equivalent to a residual obligation without the symbol.
+* `nonconvex_two_point_fails`: with non-convex value sets the two-point conditions do not suffice,
+  so convexity is a real hypothesis.
+
+All three are axiom-free or use only `propext`/`Quot.sound` (see the `#print axioms` lines).
+-/
+namespace ProofScope.MonoElim
+
+def Mono (f : Nat → Nat) : Prop := ∀ a b, a ≤ b → f a ≤ f b
+
+/-- `w` respects an optional upper bound. -/
+def LeOpt (w : Nat) (o : Option Nat) : Prop := ∀ k, o = some k → w ≤ k
+
+/-- Convex reference constraints: `l z ≤ f z` and, where given, `f z ≤ u z`. -/
+def Box (l : Nat → Nat) (u : Nat → Option Nat) (f : Nat → Nat) : Prop :=
+  ∀ z, l z ≤ f z ∧ LeOpt (f z) (u z)
+
+/-- Running maximum of the lower bounds. -/
+def L (l : Nat → Nat) : Nat → Nat
+  | 0 => l 0
+  | z + 1 => max (L l z) (l (z + 1))
+
+theorem L_ge (l : Nat → Nat) : ∀ z, l z ≤ L l z
+  | 0 => Nat.le_refl _
+  | _ + 1 => Nat.le_max_right _ _
+
+theorem L_step (l : Nat → Nat) (z : Nat) : L l z ≤ L l (z + 1) := Nat.le_max_left _ _
+
+theorem L_mono (l : Nat → Nat) : ∀ a b, a ≤ b → L l a ≤ L l b := by
+  intro a b h
+  induction b with
+  | zero => have : a = 0 := Nat.le_zero.1 h; subst this; exact Nat.le_refl _
+  | succ n ih =>
+    rcases Nat.lt_or_ge a (n + 1) with h' | h'
+    · exact Nat.le_trans (ih (Nat.le_of_lt_succ h')) (L_step l n)
+    · have : a = n + 1 := Nat.le_antisymm h h'; subst this; exact Nat.le_refl _
+
+theorem L_attained (l : Nat → Nat) : ∀ z, ∃ a, a ≤ z ∧ L l z = l a
+  | 0 => ⟨0, Nat.le_refl _, rfl⟩
+  | z + 1 => by
+    obtain ⟨a, ha, e⟩ := L_attained l z
+    rcases Nat.le_total (L l z) (l (z + 1)) with h | h
+    · exact ⟨z + 1, Nat.le_refl _, Nat.max_eq_right h⟩
+    · exact ⟨a, Nat.le_succ_of_le ha, by show max (L l z) (l (z + 1)) = l a; rw [Nat.max_eq_left h, e]⟩
+
+/-- The canonical monotone solution through `(z₀, w₀)`. -/
+def canon (l : Nat → Nat) (z₀ w₀ : Nat) (z : Nat) : Nat :=
+  if z < z₀ then L l z else max (L l z) w₀
+
+/-- **Two-point extension.** -/
+theorem mono_extension (l : Nat → Nat) (u : Nat → Option Nat) (z₀ w₀ : Nat) :
+    (∃ f, Mono f ∧ Box l u f ∧ f z₀ = w₀) ↔
+      ((∀ a b, a ≤ b → LeOpt (l a) (u b)) ∧ (∀ a, a ≤ z₀ → l a ≤ w₀) ∧
+        (∀ b, z₀ ≤ b → LeOpt w₀ (u b))) := by
+  constructor
+  · intro ⟨f, hm, hb, e⟩
+    refine ⟨fun a b hab k hk => ?_, fun a ha => ?_, fun b hb' k hk => ?_⟩
+    · exact Nat.le_trans (hb a).1 (Nat.le_trans (hm a b hab) ((hb b).2 k hk))
+    · exact e ▸ Nat.le_trans (hb a).1 (hm a z₀ ha)
+    · exact e ▸ Nat.le_trans (hm z₀ b hb') ((hb b).2 k hk)
+  · intro ⟨hfeas, hlo, hup⟩
+    have hLu : ∀ z k, u z = some k → L l z ≤ k := fun z k hk => by
+      obtain ⟨a, ha, e⟩ := L_attained l z
+      rw [e]; exact hfeas a z ha k hk
+    have hLw : L l z₀ ≤ w₀ := by
+      obtain ⟨a, ha, e⟩ := L_attained l z₀
+      rw [e]; exact hlo a ha
+    refine ⟨canon l z₀ w₀, ?_, ?_, ?_⟩
+    · intro a b hab
+      unfold canon
+      by_cases ha : a < z₀ <;> by_cases hb : b < z₀ <;> simp only [ha, hb, ↓reduceIte]
+      · exact L_mono l a b hab
+      · exact Nat.le_trans (L_mono l a b hab) (Nat.le_max_left _ _)
+      · omega
+      · exact Nat.max_le.2 ⟨Nat.le_trans (L_mono l a b hab) (Nat.le_max_left _ _), Nat.le_max_right _ _⟩
+    · intro z
+      unfold canon
+      by_cases hz : z < z₀ <;> simp only [hz, ↓reduceIte]
+      · exact ⟨L_ge l z, hLu z⟩
+      · exact ⟨Nat.le_trans (L_ge l z) (Nat.le_max_left _ _),
+          fun k hk => Nat.max_le.2 ⟨hLu z k hk, hup z (Nat.le_of_not_lt hz) k hk⟩⟩
+    · unfold canon
+      simp only [Nat.lt_irrefl, ↓reduceIte]
+      exact Nat.max_eq_right hLw
+
+/-- **Elimination under monotonicity.** For a feasible convex reference, entailment of a formal
+claim `∀ y, B y → θ y (f (t y))` over all monotone `f` is a symbol-free obligation. -/
+theorem mono_elim (l : Nat → Nat) (u : Nat → Option Nat) {Y : Sort v} (B : Y → Prop) (t : Y → Nat)
+    (θ : Y → Nat → Prop) (hfeas : ∀ a b, a ≤ b → LeOpt (l a) (u b)) :
+    (∀ f, Mono f → Box l u f → ∀ y, B y → θ y (f (t y))) ↔
+      ∀ y w, B y → (∀ a, a ≤ t y → l a ≤ w) → (∀ b, t y ≤ b → LeOpt w (u b)) → θ y w := by
+  constructor
+  · intro h y w hB hlo hup
+    obtain ⟨f, hm, hb, e⟩ := (mono_extension l u (t y) w).2 ⟨hfeas, hlo, hup⟩
+    exact e ▸ h f hm hb y hB
+  · intro h f hm hb y hB
+    have := (mono_extension l u (t y) (f (t y))).1 ⟨f, hm, hb, rfl⟩
+    exact h y _ hB this.2.1 this.2.2
+
+/-- An infeasible reference is vacuous over monotone functions: it entails everything. -/
+theorem mono_vacuous (l : Nat → Nat) (u : Nat → Option Nat) {a b k : Nat} (hab : a ≤ b)
+    (hk : u b = some k) (hlt : k < l a) : ∀ f, Mono f → ¬ Box l u f :=
+  fun _ hm hb => absurd (Nat.le_trans (hb a).1 (Nat.le_trans (hm a b hab) ((hb b).2 k hk)))
+    (Nat.not_le.2 hlt)
+
+/-- **Convexity is needed.** Value sets `{1}, {0, 2}, {1}` at arguments `0, 1, 2` are pairwise
+compatible with monotonicity, yet no monotone function selects from all three. -/
+theorem nonconvex_two_point_fails :
+    let C : Nat → Nat → Prop := fun z w => (z = 0 → w = 1) ∧ (z = 1 → w = 0 ∨ w = 2) ∧ (z = 2 → w = 1)
+    (∀ a b, a ≤ b → b ≤ 2 → ∃ wa wb, C a wa ∧ C b wb ∧ wa ≤ wb) ∧
+      ¬ ∃ f, Mono f ∧ ∀ z, C z (f z) := by
+  refine ⟨?_, ?_⟩
+  · intro a b hab hb
+    have ha : a = 0 ∨ a = 1 ∨ a = 2 := by omega
+    have hb' : b = 0 ∨ b = 1 ∨ b = 2 := by omega
+    rcases ha with rfl | rfl | rfl <;> rcases hb' with rfl | rfl | rfl <;>
+      first
+        | omega
+        | exact ⟨1, 1, by omega, by omega, by omega⟩
+        | exact ⟨1, 2, by omega, by omega, by omega⟩
+        | exact ⟨0, 1, by omega, by omega, by omega⟩
+        | exact ⟨0, 0, by omega, by omega, by omega⟩
+        | exact ⟨0, 2, by omega, by omega, by omega⟩
+  · intro ⟨f, hm, hc⟩
+    have h0 := (hc 0).1 rfl
+    have h1 := (hc 1).2.1 rfl
+    have h2 := (hc 2).2.2 rfl
+    have m01 := hm 0 1 (by omega)
+    have m12 := hm 1 2 (by omega)
+    omega
+
+/-- The SOTA-14 test T8, now decided by the criterion: over monotone functions the formal claim
+`1 ≤ f 1` gives the reference `∀ n, 1 ≤ f (n + 1)`. -/
+example : ∀ f, Mono f → Box (fun z => if z = 1 then 1 else 0) (fun _ => none) f →
+    ∀ n : Nat, True → 1 ≤ f (n + 1) :=
+  (mono_elim _ _ (fun _ : Nat => True) (fun n => n + 1) (fun _ w => 1 ≤ w)
+    (fun _ _ _ _ hk => by cases hk)).2
+    (fun y w _ hlo _ => by have := hlo 1 (by omega); simpa using this)
+
+end ProofScope.MonoElim
+
+#print axioms ProofScope.MonoElim.mono_extension
+#print axioms ProofScope.MonoElim.mono_elim
+#print axioms ProofScope.MonoElim.mono_vacuous
+#print axioms ProofScope.MonoElim.nonconvex_two_point_fails
