diff --git a/bench/ingest.py b/bench/ingest.py
new file mode 100644
index 0000000..8ac6679
--- /dev/null
+++ b/bench/ingest.py
@@ -0,0 +1,83 @@
+"""Build the candidate pool (cases + source labels, kept in separate files) from public sources.
+
+    python -m bench.ingest epla --assess-dir DIR --out pool/        # ASSESS repo at a pinned commit
+    python -m bench.ingest proofnetverif --split test --out pool/   # Hugging Face PAug/ProofNetVerif (runner only)
+
+Source labels are what the source published. They are NOT gold: gold comes only from the blinded
+adjudication. They are written to `source_labels.jsonl`, never into `cases.jsonl`.
+Every source is a vendor-home benchmark for at least one competitor (EPLA: ASSESS/TransTED;
+ProofNetVerif: BEq+, and SemantEq re-adjudicated its test split); results on these slices are reported
+per source and never pooled with the new independent holdout.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+from .canonical import norm_hash, validate, write_jsonl
+
+
+def _cid(*parts: str) -> str:
+    return "c-" + hashlib.sha256("\x1f".join(parts).encode()).hexdigest()[:12]
+
+
+def epla(assess_dir: Path) -> tuple[list[dict], list[dict]]:
+    import subprocess
+    commit = subprocess.run(["git", "rev-parse", "HEAD"], cwd=assess_dir, capture_output=True, text=True).stdout.strip()
+    cases, labels = [], []
+    for split, fname in (("epla-minif2f", "EPLA-miniF2F.json"), ("epla-proofnet", "EPLA-ProofNet.json")):
+        data = json.loads((assess_dir / "benchmark" / fname).read_text())
+        for e in data:
+            for j, s in enumerate(e["sub_questions"]):
+                c = {"case_id": _cid(split, str(e["id"]), str(j)), "group": f"{split}:{e['name']}", "source": split,
+                     "source_ref": f"{fname}#id={e['id']}/sub={j}", "ref_header": e["header"], "ref_decl": e["FL (Label)"],
+                     "cand_header": s["header"], "cand_decl": s["FL (Prediction)"],
+                     "informal": e.get("NL"), "generator": s.get("tag"),
+                     "provenance": {"repo": "https://github.com/XiaoyangLiu-sjtu/ASSESS", "commit": commit,
+                                    "license": "Apache-2.0", "file": f"benchmark/{fname}"}}
+                assert not validate(c), validate(c)
+                cases.append(c)
+                labels.append({"case_id": c["case_id"], "source_label_equivalent": s.get("likeness after transformation"),
+                               "source_label_field": "likeness after transformation", "source": split})
+    return cases, labels
+
+
+def proofnetverif(split: str) -> tuple[list[dict], list[dict]]:
+    from datasets import load_dataset
+    ds = load_dataset("PAug/ProofNetVerif", split=split)
+    cases, labels = [], []
+    for i, ex in enumerate(ds):
+        ref, cand = ex["lean4_formalization"], ex["lean4_prediction"]
+        name = ex["id"]
+        c = {"case_id": _cid("pnv", split, str(i)), "group": f"pnv:{name}", "source": f"proofnetverif-{split}",
+             "source_ref": f"pnv:{split}:{i:04d}:{name}", "ref_header": ex["lean4_src_header"], "ref_decl": ref,
+             "cand_header": ex["lean4_src_header"], "cand_decl": cand, "informal": ex.get("nl_statement"),
+             "provenance": {"dataset": "PAug/ProofNetVerif", "split": split, "row": i}}
+        if validate(c):
+            continue
+        cases.append(c)
+        labels.append({"case_id": c["case_id"], "source_label_equivalent": bool(ex["correct"]),
+                       "source_label_field": "correct", "source": c["source"]})
+    return cases, labels
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.ingest")
+    ap.add_argument("source", choices=["epla", "proofnetverif"])
+    ap.add_argument("--assess-dir", type=Path)
+    ap.add_argument("--split", default="test")
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args(argv)
+    cases, labels = epla(a.assess_dir) if a.source == "epla" else proofnetverif(a.split)
+    tag = a.source if a.source == "epla" else f"pnv-{a.split}"
+    write_jsonl(a.out / f"{tag}.cases.jsonl", cases)
+    write_jsonl(a.out / f"{tag}.source_labels.jsonl", labels)
+    dup = len(cases) - len({norm_hash(c["cand_decl"]) + norm_hash(c["ref_decl"]) for c in cases})
+    print(json.dumps({"source": tag, "cases": len(cases), "exact_duplicate_pairs": dup}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/bench/limits.py b/bench/limits.py
new file mode 100644
index 0000000..151c6ec
--- /dev/null
+++ b/bench/limits.py
@@ -0,0 +1,118 @@
+"""Run one process under a hard CPU-time and address-space limit and account for its resources.
+
+The limit is applied from outside (`prlimit`), so it binds every tool the same way whether or not the
+tool has its own budget flag. A process killed by SIGXCPU/SIGKILL at the limit is a TIMEOUT, never an
+abstention. CPU time and peak RSS come from `wait4` for that child (its own rusage, including its
+descendants that it waited for), not from the parent's cumulative counters.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import signal
+import subprocess
+import threading
+import time
+from dataclasses import asdict, dataclass
+
+
+@dataclass
+class Run:
+    exit_code: int | None
+    signal: str | None
+    status: str            # OK | TIMEOUT_CPU | TIMEOUT_WALL | OOM_OR_KILLED | ERROR
+    cpu_user_s: float
+    cpu_sys_s: float
+    wall_s: float
+    max_rss_mb: float
+    stdout: str
+    stderr: str
+
+    def as_dict(self) -> dict:
+        d = asdict(self)
+        d["cpu_s"] = round(self.cpu_user_s + self.cpu_sys_s, 3)
+        return d
+
+
+def run_limited(cmd: list[str], cpu_s: float, mem_mb: int, wall_s: float, cwd: str | None = None,
+                env: dict | None = None) -> Run:
+    if shutil.which("prlimit") is None:
+        raise RuntimeError("prlimit not found: the CPU limit cannot be enforced (INFRASTRUCTURE)")
+    soft = max(1, int(round(cpu_s)))
+    # CPU: hard kernel limit. Memory: a resident-set watchdog over the whole process group (an
+    # address-space rlimit is unusable for Lean, which reserves large virtual ranges for its threads).
+    full = ["prlimit", f"--cpu={soft}:{soft + 1}", "--"] + cmd
+    t0 = time.monotonic()
+    p = subprocess.Popen(full, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                         start_new_session=True)
+    bufs = {"out": [], "err": []}
+
+    def pump(stream, key):
+        for chunk in iter(lambda: stream.read(65536), b""):
+            bufs[key].append(chunk)
+
+    ts = [threading.Thread(target=pump, args=(p.stdout, "out"), daemon=True),
+          threading.Thread(target=pump, args=(p.stderr, "err"), daemon=True)]
+    for t in ts:
+        t.start()
+    wall_hit, mem_hit, status_word, ru, peak_group_mb = False, False, 0, None, 0.0
+    while True:
+        pid, status_word, ru = os.wait4(p.pid, os.WNOHANG)
+        if pid == p.pid:
+            break
+        g = _group_rss_mb(p.pid)
+        peak_group_mb = max(peak_group_mb, g)
+        if g > mem_mb:
+            mem_hit = True
+            os.killpg(p.pid, signal.SIGKILL)
+            pid, status_word, ru = os.wait4(p.pid, 0)
+            break
+        if time.monotonic() - t0 > wall_s:
+            wall_hit = True
+            os.killpg(p.pid, signal.SIGKILL)
+            pid, status_word, ru = os.wait4(p.pid, 0)
+            break
+        time.sleep(0.05)
+    for t in ts:
+        t.join(timeout=5)
+    p.returncode = os.waitstatus_to_exitcode(status_word)
+    wall = time.monotonic() - t0
+    rc = p.returncode
+    sig = signal.Signals(-rc).name if rc is not None and rc < 0 else None
+    cpu = ru.ru_utime + ru.ru_stime
+    if mem_hit:
+        status = "OOM"
+    elif wall_hit:
+        status = "TIMEOUT_WALL"
+    elif sig == "SIGXCPU" or (sig == "SIGKILL" and cpu >= soft - 0.5):
+        status = "TIMEOUT_CPU"
+    elif sig in ("SIGKILL", "SIGSEGV", "SIGABRT"):
+        status = "OOM_OR_KILLED"
+    elif rc == 0:
+        status = "OK"
+    else:
+        status = "ERROR"
+    dec = lambda b: b"".join(b).decode("utf-8", "replace")
+    if status == "ERROR" and any(m in dec(bufs["err"]) for m in ("MemoryError", "out of memory", "bad_alloc", "Cannot allocate")):
+        status = "OOM"
+    return Run(rc, sig, status, round(ru.ru_utime, 3), round(ru.ru_stime, 3), round(wall, 3),
+               round(max(ru.ru_maxrss / 1024, peak_group_mb), 1), dec(bufs["out"]), dec(bufs["err"]))
+
+
+def _group_rss_mb(pgid: int) -> float:
+    """Sum of VmRSS over all processes in the session/process group `pgid` (Linux /proc)."""
+    total = 0
+    for d in os.listdir("/proc"):
+        if not d.isdigit():
+            continue
+        try:
+            if os.getpgid(int(d)) != pgid:
+                continue
+            with open(f"/proc/{d}/status") as f:
+                for line in f:
+                    if line.startswith("VmRSS:"):
+                        total += int(line.split()[1])
+                        break
+        except (OSError, ProcessLookupError):
+            continue
+    return total / 1024
diff --git a/bench/outcomes.py b/bench/outcomes.py
new file mode 100644
index 0000000..ee7fb43
--- /dev/null
+++ b/bench/outcomes.py
@@ -0,0 +1,65 @@
+"""Pre-registered mapping from each tool's native verdict to the shared outcome vocabulary.
+
+Two readings are reported side by side, never merged:
+
+* `certified` (3-way): EQUIV / NONEQUIV only when the tool's output is backed by a machine-checked
+  artefact for that claim; everything else is ABSTAIN. A failed proof search is never NONEQUIV.
+* `native` (binary): the tool's own published accept/reject reading (what its paper scores), with
+  abstentions folded into NONEQUIV exactly as that tool's authors do. Reported for comparability with
+  published numbers only.
+
+Infrastructure outcomes (TIMEOUT_*, OOM*, ERROR, NON_ELABORATING, UNSUPPORTED_INPUT, INCOMPATIBLE) are kept
+as such in both readings and are never converted into abstentions or verdicts.
+
+Track A = whole-statement logical equivalence; Track B = faithful statement equivalence. A tool's EQUIV
+is the same claim in both tracks (gold differs); a tool's NONEQUIV is admissible in Track B when it
+certifies a semantic difference that need not make the closed propositions inequivalent (ProofScope's
+schema-level separations); such outputs are ABSTAIN in Track A.
+"""
+from __future__ import annotations
+
+INFRA = {"TIMEOUT_CPU", "TIMEOUT_WALL", "OOM", "OOM_OR_KILLED", "ERROR", "NON_ELABORATING", "UNSUPPORTED_INPUT",
+         "INCOMPATIBLE"}
+
+# ProofScope v1.2 (adelta12; proofscope/v12.py)
+PS_EQUIV = {"ASSUMPTION_EQUIVALENT", "NO_ASSUMPTION_DELTA", "IDENTICAL", "SCHEMA_EQUIVALENT", "EQUIVALENT_BY_LAWS"}
+PS_SCHEMA_DIFF = {"LEAN_WEAKER_BY_ASSUMPTION", "LEAN_STRONGER_BY_ASSUMPTION", "ASSUMPTION_INCOMPARABLE",
+                  "REFERENCE_NEEDS_ASSUMPTION", "LEAN_CLAIM_FALSE"}
+# SemantEq (README at the pinned commit)
+SE_EQUIV = {"ExactMatch", "DefEq", "EquivalentRestricted"}
+SE_ONE_DIR = {"LikelyTooStrong", "LikelyTooWeak"}
+SE_INFRA = {"Timeout": "TIMEOUT_WALL", "ContextMergeError": "INCOMPATIBLE", "NotAProposition": "UNSUPPORTED_INPUT",
+            "MalformedInput": "UNSUPPORTED_INPUT", "InternalError": "ERROR"}
+
+
+def proofscope(verdict: str, track: str) -> dict:
+    if verdict in PS_EQUIV:
+        c = "EQUIV"
+    elif verdict in PS_SCHEMA_DIFF:
+        c = "NONEQUIV" if track == "B" else "ABSTAIN"
+    elif verdict == "BOTH_CLAIMS_FALSE":
+        # both closed statements are refuted, so they are logically equivalent (False ↔ False); fidelity open
+        c = "EQUIV" if track == "A" else "ABSTAIN"
+    elif verdict.startswith("INCONCLUSIVE") and "extraction" in verdict.lower():
+        c = "NON_ELABORATING"
+    else:
+        c = "ABSTAIN"
+    native = "EQUIV" if c == "EQUIV" else "NONEQUIV"
+    return {"certified": c, "native": native}
+
+
+def semanteq(verdict: str, track: str) -> dict:
+    if verdict in SE_INFRA:
+        return {"certified": SE_INFRA[verdict], "native": SE_INFRA[verdict]}
+    if verdict.endswith("CompileError") or verdict.endswith("NoStatement"):
+        return {"certified": "NON_ELABORATING", "native": "NON_ELABORATING"}
+    if verdict in SE_EQUIV:
+        return {"certified": "EQUIV", "native": "EQUIV"}
+    # one proved direction or nothing: no certificate of a difference
+    return {"certified": "ABSTAIN", "native": "NONEQUIV"}
+
+
+def beqplus(result: bool | None, track: str) -> dict:
+    if result is None:
+        return {"certified": "ERROR", "native": "ERROR"}
+    return {"certified": "EQUIV" if result else "ABSTAIN", "native": "EQUIV" if result else "NONEQUIV"}
diff --git a/bench/runner.py b/bench/runner.py
new file mode 100644
index 0000000..94a9e3d
--- /dev/null
+++ b/bench/runner.py
@@ -0,0 +1,144 @@
+"""Shared benchmark runner: every eligible system, every case, one budget tier, full evidence.
+
+    python -m bench.runner --system proofscope --cases sealed/primary.cases.jsonl --tier 20 \
+        --startup-allowance 0 --mem-mb 12000 --out runs/ [--shard i/n] [--tool-dir DIR] [--repeat 1]
+
+Per pair, the external CPU limit is `tier + startup_allowance` seconds. The startup allowance is the
+tool's median CPU on the frozen calibration pair (identical statements) measured in the pilot and
+written into the run manifest BEFORE the primary run (protocol amendment A1, docs/sota1/). Adapter work
+(format conversion, ProofScope's meaning-preservation check) is timed and reported separately and is not
+charged to the tool. Every case gets exactly one record per system and repeat, whatever happened.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import platform
+import shutil
+import time
+from pathlib import Path
+
+from .canonical import read_jsonl, sha256_file
+from .limits import run_limited
+
+ADAPTER_CPU_S, ADAPTER_WALL_S = 300, 600
+
+
+def _shard(rows, spec):
+    if not spec:
+        return rows
+    i, n = (int(x) for x in spec.split("/"))
+    return [r for k, r in enumerate(rows) if k % n == i]
+
+
+def run_proofscope(case, work: Path, budget: float, mem_mb: int, lean: str) -> dict:
+    from .adapters import proofscope as A
+    prep = A.prepare(case, work, [lean])
+    rec = {"adapter": {}}
+    if "unsupported" in prep:
+        rec["status"] = "UNSUPPORTED_INPUT"
+        rec["adapter"]["error"] = prep["unsupported"]
+        return rec
+    env = A.imports_env(prep["imports"])
+    printed = {}
+    for side, cmd in zip(("ref", "cand"), prep["print_cmds"]):
+        r = run_limited(cmd, ADAPTER_CPU_S, mem_mb, ADAPTER_WALL_S, cwd=str(work), env=env)
+        rec["adapter"][f"print_{side}"] = {k: v for k, v in r.as_dict().items() if k not in ("stdout", "stderr")}
+        p = A.extract_printed(r.stdout + r.stderr)
+        if r.status != "OK" or p is None:
+            rec["status"] = "NON_ELABORATING" if r.status in ("OK", "ERROR") else "ADAPTER_" + r.status
+            rec["adapter"][f"print_{side}_log"] = (r.stdout + r.stderr)[-3000:]
+            return rec
+        printed[side] = p
+        h, d = (case["ref_header"], case["ref_decl"]) if side == "ref" else (case["cand_header"], case["cand_decl"])
+        f = work / f"{side}_check.lean"
+        f.write_text(A.check_file(h, d, f"ps_{side}_decl", prep["imports"], p))
+        c = run_limited([lean, str(f)], ADAPTER_CPU_S, mem_mb, ADAPTER_WALL_S, cwd=str(work), env=env)
+        rec["adapter"][f"check_{side}"] = {k: v for k, v in c.as_dict().items() if k not in ("stdout", "stderr")}
+        if c.status != "OK" or ": error" in (c.stdout + c.stderr):
+            rec["status"] = "UNSUPPORTED_INPUT"
+            rec["adapter"]["error"] = f"printed {side} statement does not round-trip: " + (c.stdout + c.stderr)[-1500:]
+            return rec
+    rec["printed"] = printed
+    r = run_limited(A.engine_cmd(case["case_id"], printed["ref"], printed["cand"], work), budget, mem_mb,
+                    3 * budget + 120, cwd=None, env=env)
+    rec["run"] = {k: v for k, v in r.as_dict().items() if k not in ("stdout", "stderr")}
+    rec["log_tail"] = (r.stdout + r.stderr)[-3000:]
+    rec["status"] = r.status
+    rec.update(A.parse_engine(case["case_id"], work))
+    return rec
+
+
+def run_semanteq(case, work: Path, budget: float, tier: int, mem_mb: int, tool_dir: Path) -> dict:
+    from .adapters import semanteq as A
+    prep = A.prepare(case, work, tool_dir, tier)
+    r = run_limited(prep["cmd"], budget, mem_mb, 3 * budget + 120, cwd=prep["cwd"])
+    rec = {"run": {k: v for k, v in r.as_dict().items() if k not in ("stdout", "stderr")},
+           "log_tail": (r.stdout + r.stderr)[-3000:], "status": r.status}
+    rec.update(A.parse(case, Path(prep["result"])))
+    return rec
+
+
+def run_beqplus(case, work: Path, budget: float, tier: int, mem_mb: int, tool_dir: Path, lean_version: str) -> dict:
+    from .adapters import beqplus as A
+    prep = A.prepare(case, work, tool_dir, lean_version, tier)
+    r = run_limited(prep["cmd"], budget, mem_mb, 3 * budget + 300)
+    rec = {"run": {k: v for k, v in r.as_dict().items() if k not in ("stdout", "stderr")},
+           "log_tail": (r.stdout + r.stderr)[-3000:], "status": r.status}
+    rec.update(A.parse(case, work / "out.json"))
+    return rec
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.runner")
+    ap.add_argument("--system", required=True, choices=["proofscope", "semanteq", "beqplus"])
+    ap.add_argument("--cases", type=Path, required=True)
+    ap.add_argument("--tier", type=int, required=True, choices=[20, 180])
+    ap.add_argument("--startup-allowance", type=float, default=0.0)
+    ap.add_argument("--mem-mb", type=int, default=12000)
+    ap.add_argument("--repeat", type=int, default=1)
+    ap.add_argument("--shard")
+    ap.add_argument("--tool-dir", type=Path)
+    ap.add_argument("--lean", default="lean")
+    ap.add_argument("--beq-lean-version", default="v4.8.0")
+    ap.add_argument("--cache-state", default="unknown", choices=["cold", "warm", "unknown"])
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args(argv)
+    cases = _shard(read_jsonl(a.cases), a.shard)
+    budget = a.tier + a.startup_allowance
+    base = a.out / a.system / f"t{a.tier}"
+    base.mkdir(parents=True, exist_ok=True)
+    manifest = {"system": a.system, "tier_cpu_s": a.tier, "startup_allowance_cpu_s": a.startup_allowance,
+                "limit_cpu_s": budget, "mem_mb": a.mem_mb, "repeat": a.repeat, "shard": a.shard,
+                "cases_file_sha256": sha256_file(a.cases), "cases": len(cases), "cache_state": a.cache_state,
+                "host": platform.node(), "cpu": platform.processor() or platform.machine(),
+                "python": platform.python_version(), "prlimit": shutil.which("prlimit"),
+                "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
+    (base / f"manifest{'-' + a.shard.replace('/', 'of') if a.shard else ''}.json").write_text(json.dumps(manifest, indent=1))
+    for case in cases:
+        for rep in range(a.repeat):
+            work = a.out / "work" / a.system / f"t{a.tier}" / case["case_id"] / f"r{rep}"
+            t0 = time.time()
+            try:
+                if a.system == "proofscope":
+                    rec = run_proofscope(case, work, budget, a.mem_mb, a.lean)
+                elif a.system == "semanteq":
+                    rec = run_semanteq(case, work, budget, a.tier, a.mem_mb, a.tool_dir)
+                else:
+                    rec = run_beqplus(case, work, budget, a.tier, a.mem_mb, a.tool_dir, a.beq_lean_version)
+            except Exception as e:  # recorded, never dropped
+                rec = {"status": "RUNNER_ERROR", "error": repr(e)}
+            rec.update(case_id=case["case_id"], system=a.system, tier=a.tier, repeat=rep, group=case.get("group"),
+                       source=case.get("source"), wall_total_s=round(time.time() - t0, 3))
+            if rec.get("status") == "OK" and rec.get("native_verdict") is None:
+                rec["status"] = "ERROR_NO_OUTPUT"
+            for t in ("A", "B"):
+                if f"track_{t}" not in rec:
+                    rec[f"track_{t}"] = {"certified": rec["status"], "native": rec["status"]}
+            (base / f"{case['case_id']}.r{rep}.json").write_text(json.dumps(rec, ensure_ascii=False, indent=1))
+            print(case["case_id"], a.system, rec["status"], rec.get("native_verdict"), flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/bench/score.py b/bench/score.py
new file mode 100644
index 0000000..28fc539
--- /dev/null
+++ b/bench/score.py
@@ -0,0 +1,244 @@
+"""Scoring and uncertainty for the SOTA-1 benchmark (pre-registered; docs/competitor_benchmark_protocol.md).
+
+    python -m bench.score --runs runs/ --gold gold.jsonl --tier 20 --out metrics.json [--markdown report.md]
+
+gold.jsonl (released only after all runs are locked):
+    {"case_id": ..., "gold_A": "equivalent"|"non_equivalent"|"disputed"|"unassessable",
+     "gold_B": ..., "group": ..., "source": ...}
+
+Per system, track (A logical / B faithful) and reading (certified / native):
+    TP  EQUIV on gold equivalent            FP  EQUIV on gold non-equivalent
+    TN  NONEQUIV on gold non-equivalent     FN  NONEQUIV on gold equivalent
+    ABSTAIN, and every infrastructure outcome, kept as its own count.
+Recall and error rates use ALL eligible gold cases of that class as denominator (abstentions included).
+Intervals: exact Clopper-Pearson for proportions; group-clustered percentile bootstrap (2000 resamples,
+fixed seed) for precision/recall; exact two-sided McNemar on paired per-case correctness, Holm-adjusted.
+Disputed/unassessable cases are excluded from the primary denominator and scored both ways in a
+sensitivity table. Zero observed errors are reported with their exact upper bound, never as "zero risk".
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import random
+from collections import defaultdict
+from pathlib import Path
+
+from .canonical import read_jsonl
+from .outcomes import INFRA
+
+GOLD_OK = ("equivalent", "non_equivalent")
+
+
+def _binom_cdf(k: int, n: int, p: float) -> float:
+    if p <= 0:
+        return 1.0
+    if p >= 1:
+        return 0.0 if k < n else 1.0
+    s, term = 0.0, (1 - p) ** n
+    for i in range(0, k + 1):
+        if i > 0:
+            term *= (n - i + 1) / i * p / (1 - p)
+        s += term
+    return min(1.0, s)
+
+
+def clopper_pearson(k: int, n: int, alpha: float = 0.05) -> tuple[float, float] | None:
+    if n == 0:
+        return None
+
+    def solve(f, lo=0.0, hi=1.0):
+        for _ in range(100):
+            mid = (lo + hi) / 2
+            if f(mid):
+                hi = mid
+            else:
+                lo = mid
+        return (lo + hi) / 2
+    lower = 0.0 if k == 0 else solve(lambda p: 1 - _binom_cdf(k - 1, n, p) >= alpha / 2)
+    upper = 1.0 if k == n else solve(lambda p: _binom_cdf(k, n, p) <= alpha / 2)
+    return (round(lower, 4), round(upper, 4))
+
+
+def mcnemar_exact(b: int, c: int) -> float:
+    """Two-sided exact McNemar p-value from the discordant counts b, c."""
+    n = b + c
+    if n == 0:
+        return 1.0
+    k = min(b, c)
+    return min(1.0, 2 * _binom_cdf(k, n, 0.5))
+
+
+def holm(pvals: dict[str, float]) -> dict[str, float]:
+    items = sorted(pvals.items(), key=lambda kv: kv[1])
+    m, out, running = len(items), {}, 0.0
+    for i, (k, p) in enumerate(items):
+        running = max(running, min(1.0, (m - i) * p))
+        out[k] = round(running, 6)
+    return out
+
+
+def classify(pred: str, gold: str) -> str:
+    if pred in INFRA or pred.startswith(("ADAPTER_", "RUNNER_", "ERROR")):
+        return "INFRA:" + pred
+    if pred not in ("EQUIV", "NONEQUIV"):
+        return "ABSTAIN"
+    return {("EQUIV", "equivalent"): "TP", ("EQUIV", "non_equivalent"): "FP",
+            ("NONEQUIV", "non_equivalent"): "TN", ("NONEQUIV", "equivalent"): "FN"}[(pred, gold)]
+
+
+def metrics(cells: list[str], golds: list[str]) -> dict:
+    c = defaultdict(int)
+    for x in cells:
+        c[x] += 1
+    tp, fp, tn, fn = c["TP"], c["FP"], c["TN"], c["FN"]
+    n_eq, n_ne, n = golds.count("equivalent"), golds.count("non_equivalent"), len(cells)
+    dec = tp + fp + tn + fn
+    infra = sum(v for k, v in c.items() if k.startswith("INFRA:"))
+    r = {"eligible": n, "gold_equivalent": n_eq, "gold_non_equivalent": n_ne, "TP": tp, "FP": fp, "TN": tn, "FN": fn,
+         "ABSTAIN": c["ABSTAIN"], "INFRA": infra, "infra_breakdown": {k[6:]: v for k, v in c.items() if k.startswith("INFRA:")},
+         "precision_equiv": round(tp / (tp + fp), 4) if tp + fp else None, "precision_equiv_ci": clopper_pearson(tp, tp + fp),
+         "recall_equiv": round(tp / n_eq, 4) if n_eq else None, "recall_equiv_ci": clopper_pearson(tp, n_eq),
+         "false_equivalence_rate": round(fp / n_ne, 4) if n_ne else None, "false_equivalence_ci": clopper_pearson(fp, n_ne),
+         "false_difference_rate": round(fn / n_eq, 4) if n_eq else None, "false_difference_ci": clopper_pearson(fn, n_eq),
+         "precision_nonequiv": round(tn / (tn + fn), 4) if tn + fn else None, "precision_nonequiv_ci": clopper_pearson(tn, tn + fn),
+         "recall_nonequiv": round(tn / n_ne, 4) if n_ne else None, "recall_nonequiv_ci": clopper_pearson(tn, n_ne),
+         "decisive_coverage": round(dec / n, 4) if n else None,
+         "selective_accuracy": round((tp + tn) / dec, 4) if dec else None}
+    return r
+
+
+def cluster_bootstrap(rows: list[tuple[str, str, str]], stat, reps: int = 2000, seed: int = 20261109):
+    """rows: (group, cell, gold). Percentile 95% interval of `stat(cells, golds)` resampling groups."""
+    by = defaultdict(list)
+    for g, cell, gold in rows:
+        by[g].append((cell, gold))
+    groups = sorted(by)
+    if not groups:
+        return None
+    rng, vals = random.Random(seed), []
+    for _ in range(reps):
+        cells, golds = [], []
+        for g in (rng.choice(groups) for _ in groups):
+            for cell, gold in by[g]:
+                cells.append(cell)
+                golds.append(gold)
+        v = stat(cells, golds)
+        if v is not None:
+            vals.append(v)
+    if not vals:
+        return None
+    vals.sort()
+    return (round(vals[int(0.025 * len(vals))], 4), round(vals[min(len(vals) - 1, int(0.975 * len(vals)))], 4))
+
+
+def load_runs(runs: Path, tier: int) -> dict[str, dict[str, list[dict]]]:
+    out = defaultdict(lambda: defaultdict(list))
+    for p in sorted(runs.glob(f"*/t{tier}/*.json")):
+        if p.name.startswith("manifest"):
+            continue
+        r = json.loads(p.read_text())
+        out[r["system"]][r["case_id"]].append(r)
+    return out
+
+
+def score(runs: Path, gold_path: Path, tier: int) -> dict:
+    gold = {g["case_id"]: g for g in read_jsonl(gold_path)}
+    sysruns = load_runs(runs, tier)
+    res = {"tier_cpu_s": tier, "cases_with_gold": len(gold), "systems": {}, "paired": {}, "missing_records": {}}
+    correct = defaultdict(dict)
+    for system, by_case in sysruns.items():
+        res["missing_records"][system] = sorted(set(gold) - set(by_case))
+        res["systems"][system] = {}
+        for track in ("A", "B"):
+            for reading in ("certified", "native"):
+                rows, cells, golds, sens = [], [], [], {"disputed_as_equivalent": [], "disputed_as_non_equivalent": []}
+                for cid, g in gold.items():
+                    recs = by_case.get(cid)
+                    pred = recs[0][f"track_{track}"][reading] if recs else "MISSING"
+                    gl = g[f"gold_{track}"]
+                    if gl in GOLD_OK:
+                        cell = classify(pred, gl)
+                        rows.append((g.get("group", cid), cell, gl))
+                        cells.append(cell)
+                        golds.append(gl)
+                        if reading == "certified":
+                            correct[(track, system)][cid] = cell in ("TP", "TN")
+                    else:
+                        sens["disputed_as_equivalent"].append(classify(pred, "equivalent"))
+                        sens["disputed_as_non_equivalent"].append(classify(pred, "non_equivalent"))
+                m = metrics(cells, golds)
+                m["precision_equiv_cluster_ci"] = cluster_bootstrap(
+                    rows, lambda c, g: (c.count("TP") / (c.count("TP") + c.count("FP"))) if c.count("TP") + c.count("FP") else None)
+                m["recall_equiv_cluster_ci"] = cluster_bootstrap(
+                    rows, lambda c, g: (c.count("TP") / g.count("equivalent")) if g.count("equivalent") else None)
+                m["disputed_sensitivity"] = {k: {x: v.count(x) for x in set(v)} for k, v in sens.items()}
+                m["by_source"] = {}
+                for src in sorted({gold[c].get("source") for c in gold}):
+                    ids = [cid for cid in gold if gold[cid].get("source") == src and gold[cid][f"gold_{track}"] in GOLD_OK]
+                    m["by_source"][src] = metrics([classify((by_case.get(cid) or [{f"track_{track}": {reading: "MISSING"}}])[0][f"track_{track}"][reading],
+                                                            gold[cid][f"gold_{track}"]) for cid in ids],
+                                                  [gold[cid][f"gold_{track}"] for cid in ids])
+                cpu = [r["run"]["cpu_s"] for recs in by_case.values() for r in recs if r.get("run")]
+                m["cpu_s_quantiles"] = _quantiles(cpu)
+                res["systems"][system][f"{track}/{reading}"] = m
+    for track in ("A", "B"):
+        systems = sorted(s for (t, s) in correct if t == track)
+        pv = {}
+        for i, s1 in enumerate(systems):
+            for s2 in systems[i + 1:]:
+                ids = set(correct[(track, s1)]) & set(correct[(track, s2)])
+                b = sum(correct[(track, s1)][k] and not correct[(track, s2)][k] for k in ids)
+                c = sum(correct[(track, s2)][k] and not correct[(track, s1)][k] for k in ids)
+                key = f"{s1}_vs_{s2}"
+                res["paired"][f"{track}:{key}"] = {"paired_cases": len(ids), f"{s1}_only_correct": b, f"{s2}_only_correct": c,
+                                                   "mcnemar_exact_p": round(mcnemar_exact(b, c), 6)}
+                pv[f"{track}:{key}"] = mcnemar_exact(b, c)
+        for k, v in holm(pv).items():
+            res["paired"][k]["holm_p"] = v
+    return res
+
+
+def _quantiles(xs):
+    if not xs:
+        return None
+    xs = sorted(xs)
+    q = lambda f: xs[min(len(xs) - 1, int(f * len(xs)))]
+    return {"p50": q(0.5), "p90": q(0.9), "p99": q(0.99), "max": xs[-1], "n": len(xs)}
+
+
+def markdown(res: dict) -> str:
+    L = [f"# Scores at {res['tier_cpu_s']} CPU-s per pair", ""]
+    for system, d in res["systems"].items():
+        for key, m in d.items():
+            L.append(f"## {system} — track {key}")
+            L.append("| eligible | TP | FP | TN | FN | abstain | infra | prec(eq) [CP 95%] | recall(eq) [CP 95%] | false-eq rate [CP 95%] | coverage |")
+            L.append("|---|---|---|---|---|---|---|---|---|---|---|")
+            L.append(f"| {m['eligible']} | {m['TP']} | {m['FP']} | {m['TN']} | {m['FN']} | {m['ABSTAIN']} | {m['INFRA']} | "
+                     f"{m['precision_equiv']} {m['precision_equiv_ci']} | {m['recall_equiv']} {m['recall_equiv_ci']} | "
+                     f"{m['false_equivalence_rate']} {m['false_equivalence_ci']} | {m['decisive_coverage']} |")
+            L.append("")
+    L.append("## Paired comparisons (certified reading; exact McNemar, Holm)")
+    for k, v in res["paired"].items():
+        L.append(f"- {k}: {v}")
+    return "\n".join(L) + "\n"
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m bench.score")
+    ap.add_argument("--runs", type=Path, required=True)
+    ap.add_argument("--gold", type=Path, required=True)
+    ap.add_argument("--tier", type=int, required=True)
+    ap.add_argument("--out", type=Path, required=True)
+    ap.add_argument("--markdown", type=Path)
+    a = ap.parse_args(argv)
+    res = score(a.runs, a.gold, a.tier)
+    a.out.write_text(json.dumps(res, indent=1))
+    if a.markdown:
+        a.markdown.write_text(markdown(res))
+    print(markdown(res))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
