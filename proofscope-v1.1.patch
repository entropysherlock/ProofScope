+name: ProofScope v1.1 Linking, Composition and Minimality
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [main]
+    paths:
+      - ".github/workflows/proofscope-v11.yml"
+      - "proofscope/adelta11.py"
+      - "lean/ProofScope/AssumptionExtract11.lean"
+      - "lean/ProofScope/Composition.lean"
+      - "proofscope/benchmark/v11_*/**"
+      - "proofscope/benchmark/V11_FREEZE.txt"
+      - "tests/v02/test_v11.py"
+
+permissions:
+  contents: read
+
+jobs:
+  v11:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 150
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install Lean 4.34.1 (pinned SHA-256, retries, cache; fails closed as INFRASTRUCTURE_ERROR)
+        uses: ./.github/actions/setup-lean
+      - name: Freeze check (V11_FREEZE.txt block 2)
+        shell: bash
+        run: |
+          set -euo pipefail
+          awk '/^# Block 2 \(v1.1.1\)/{f=1;next} f && /^[0-9a-f]{64}  [a-z]+\//' proofscope/benchmark/V11_FREEZE.txt > /tmp/f.sha
+          test "$(wc -l < /tmp/f.sha)" = 5
+          sha256sum -c /tmp/f.sha
+      - name: Composition theory (14 axiom-free + 1 propext-only theorems, fresh replay)
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p "$RUNNER_TEMP/cp/ProofScope" v11-evidence
+          lean -R lean -o "$RUNNER_TEMP/cp/ProofScope/ClaimDelta.olean" lean/ProofScope/ClaimDelta.lean > /dev/null
+          LEAN_PATH="$RUNNER_TEMP/cp" lean -R lean -o "$RUNNER_TEMP/cp/ProofScope/AssumptionDelta.olean" lean/ProofScope/AssumptionDelta.lean > /dev/null
+          LEAN_PATH="$RUNNER_TEMP/cp" lean -R lean -o "$RUNNER_TEMP/cp/ProofScope/Composition.olean" \
+            lean/ProofScope/Composition.lean | tee v11-evidence/composition-axioms.log
+          test "$(grep -c 'does not depend on any axioms' v11-evidence/composition-axioms.log)" = 14
+          grep -q "substitutable_example' depends on axioms: \[propext\]" v11-evidence/composition-axioms.log
+          ! grep -q sorryAx v11-evidence/composition-axioms.log
+          (cd "$RUNNER_TEMP/cp" && LEAN_PATH="$RUNNER_TEMP/cp" leanchecker --fresh ProofScope.Composition)
+      - name: Tests
+        run: python -m unittest tests.v02.test_v11 -v
+      - name: Assumption Delta v1.1 (v1.1 suites + v1.0 regression)
+        run: |
+          python -m proofscope.adelta11 proofscope/benchmark/v11_dev/*.json proofscope/benchmark/v11_hostile/*.json \
+            proofscope/benchmark/adelta_v10_dev/*.json proofscope/benchmark/v10_adversarial/x*.json \
+            --out v11-evidence/adelta11 --jobs 4 | tee v11-evidence/adelta11.log
+      - name: Summary
+        if: always()
+        shell: bash
+        run: |
+          python - <<'PY' >> "$GITHUB_STEP_SUMMARY"
+          import json, pathlib
+          p = pathlib.Path("v11-evidence/adelta11/adelta_results.json")
+          print("## ProofScope v1.1 (core Lean)")
+          if p.exists():
+              rows = json.loads(p.read_text())["rows"]
+              ok = sum(r["verdict"] == r.get("expected") for r in rows)
+              bad = [r["id"] for r in rows if r["verdict"] in (r.get("must_not_be") or [])]
+              print(f"- {len(rows)} cases, label match {ok}, must-not-be violations {bad}")
+          print("Development data. Known: ad02 author label error; h06 reports CONCLUSION_ONLY_CHANGE (label said INCONCLUSIVE).")
+          PY
+      - name: Upload evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: proofscope-v11-evidence
+          path: v11-evidence/
+          if-no-files-found: warn
