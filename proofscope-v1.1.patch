+{
+ "id": "m05_group_needed_comm",
+ "domain": "Algebra",
+ "family": "reference needs commutativity",
+ "reference": "∀ (G : Type) [Group G] (a b : G), (a * b)⁻¹ = a⁻¹ * b⁻¹",
+ "lean": "∀ (G : Type) [Group G], (∀ (x y : G), x * y = y * x) → ∀ (a b : G), (a * b)⁻¹ = a⁻¹ * b⁻¹",
+ "expected": "REFERENCE_NEEDS_ASSUMPTION",
