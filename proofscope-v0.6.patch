index 0000000..85f96ec
--- /dev/null
+++ b/.github/workflows/proofscope-research-audit.yml
@@ -0,0 +1,141 @@
+name: ProofScope Research Audit
+
+# v0.6: theorem dossiers for real research statements (OpenAI comparator challenges, Mathlib-based).
+#
+# Trust and isolation
+# - The corpus's own Lake configuration is never executed: ProofScope writes its own lakefile pinning Mathlib to
+#   the exact revision recorded in the corpus manifest.
+# - Network is used only before any corpus code runs: corpus checkout (pinned commit, verified) and Mathlib
+#   (pinned revision) plus its official binary cache.
+# - Compiling/elaborating corpus files (which can run code at elaboration time) and the dossier extraction run
+#   under `unshare --net` (no network), with `env -i` (no tokens or runner variables), as the non-root runner user.
+# - Not isolated: the runner's filesystem. A malicious corpus file could alter files in the workspace, including
+#   the evidence written afterwards. The job token is read-only and no secrets are referenced.
+
+on:
+  workflow_dispatch:
+    inputs:
+      limit:
+        description: "Number of research statements (round-robin across subject areas)"
+        required: false
+        default: "150"
+      replay_limit:
+        description: "Kernel-replay at most this many modules (others are reported NOT_REPLAYED)"
+        required: false
+        default: "25"
+
+permissions:
+  contents: read
+
+env:
+  CORPUS: https://github.com/openai/math
+  CORPUS_COMMIT: 4eaee87548250b2682affda7d05d947c05554bae
+
+jobs:
+  research:
+    name: Research-statement dossiers (openai/math @ 4eaee875)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 300
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - run: python -m pip install --quiet "pyyaml==6.0.2"
+      - name: Validate inputs
+        shell: bash
+        env:
+          LIMIT: ${{ inputs.limit }}
+          REPLAY_LIMIT: ${{ inputs.replay_limit }}
+        run: |
+          [[ "$LIMIT" =~ ^[0-9]{1,3}$ ]] && [[ "$REPLAY_LIMIT" =~ ^[0-9]{1,3}$ ]] || { echo "invalid input"; exit 2; }
+          echo "LIMIT=$LIMIT" >> "$GITHUB_ENV"; echo "REPLAY_LIMIT=$REPLAY_LIMIT" >> "$GITHUB_ENV"
+      - name: Free disk space
+        run: sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL && df -h /
+      - name: Install elan
+        shell: bash
+        run: |
+          set -euo pipefail
+          curl -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh -o /tmp/elan-init.sh
+          sh /tmp/elan-init.sh -y --default-toolchain none
+          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
+      - name: Fetch the pinned corpus (sparse, verified)
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p "$RUNNER_TEMP/oai" && cd "$RUNNER_TEMP/oai"
+          git init -q && git remote add origin "$CORPUS"
+          git sparse-checkout set --no-cone lean/ComparatorChallenges lean/docs lean/formalization.yaml lean/lake-manifest.json lean/lean-toolchain
+          git -c protocol.version=2 fetch -q --depth 1 --filter=blob:none origin "$CORPUS_COMMIT"
+          git checkout -q FETCH_HEAD
+          test "$(git rev-parse HEAD)" = "$CORPUS_COMMIT"
+          mkdir -p "$GITHUB_WORKSPACE/research-evidence" && git rev-parse HEAD > "$GITHUB_WORKSPACE/research-evidence/corpus_commit.txt"
+      - name: Prepare pinned research project
+        run: python -m proofscope.research prepare --oai-lean "$RUNNER_TEMP/oai/lean" --commit "$CORPUS_COMMIT" --out "$RUNNER_TEMP/research" --limit "$LIMIT" | tee research-evidence/prepare.json
+      - name: Fetch Mathlib at the pinned revision and its official cache (network; trusted inputs only)
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$RUNNER_TEMP/research"
+          lake update 2>&1 | tail -5
+          lake exe cache get 2>&1 | tail -5
+          cp lake-manifest.json "$GITHUB_WORKSPACE/research-evidence/research-lake-manifest.json"
+      - name: Build and extract dossiers in isolation (no network, empty environment, non-root)
+        shell: bash
+        run: |
+          set -uo pipefail
+          PYDIR="$(dirname "$(command -v python)")"
+          cat > "$RUNNER_TEMP/isolated.sh" <<'SH'
+          set -uo pipefail
+          cd "$RESEARCH"
+          if ! lake build $(cat modules.txt) > build.log 2>&1; then
+            : > built.txt; : > failed.txt
+            for m in $(cat modules.txt); do
+              if lake build "$m" >> build.log 2>&1; then echo "$m" >> built.txt; else echo "$m" >> failed.txt; fi
+            done
+          else
+            tr ' ' '\n' < modules.txt | sed '/^$/d' > built.txt; : > failed.txt
+          fi
+          cd "$WS" && mkdir -p research-evidence
+          python -m proofscope.dossier --project "$RESEARCH" --imports $(cat "$RESEARCH/built.txt") \
+            --modules $(cat "$RESEARCH/built.txt") --commit "$CORPUS_COMMIT" --replay-limit "$REPLAY_LIMIT" \
+            --out research-evidence/dossiers-raw > research-evidence/dossier-run.log 2>&1
+          echo "dossier exit $?" >> research-evidence/dossier-run.log
+          SH
+          sudo unshare --net -- sudo -u "$USER" env -i HOME="$HOME" LANG=C.UTF-8 \
+            PATH="$HOME/.elan/bin:$PYDIR:/usr/bin:/bin" RESEARCH="$RUNNER_TEMP/research" WS="$GITHUB_WORKSPACE" \
+            CORPUS_COMMIT="$CORPUS_COMMIT" REPLAY_LIMIT="$REPLAY_LIMIT" \
+            bash -c 'curl -sS -m 5 https://github.com >/dev/null 2>&1 && echo "ISOLATION FAILED: network reachable" && exit 3; env | grep -c . ; bash "$0"' "$RUNNER_TEMP/isolated.sh"
+          cp "$RUNNER_TEMP/research/build.log" "$RUNNER_TEMP/research/built.txt" "$RUNNER_TEMP/research/failed.txt" research-evidence/ || true
+          echo "built: $(wc -l < research-evidence/built.txt)  failed: $(wc -l < research-evidence/failed.txt)"
+      - name: Link dossiers to papers (reads files only)
+        run: |
+          python -m proofscope.research annotate --oai-lean "$RUNNER_TEMP/oai/lean" --project "$RUNNER_TEMP/research" \
+            --dossiers research-evidence/dossiers-raw/dossiers --out research-evidence/dossiers | tee research-evidence/annotate.log
+      - name: HTML viewer
+        run: >-
+          python -m proofscope.viewer --dossiers research-evidence/dossiers
+          --title "ProofScope research audit - openai/math at 4eaee875"
+          --out research-evidence/proofscope_research_report.html
+      - name: Job summary
+        if: always()
+        shell: bash
+        run: |
+          {
+            echo "## ProofScope Research Audit"
+            echo "- corpus: $CORPUS @ $CORPUS_COMMIT"
+            echo "- built modules: $(wc -l < research-evidence/built.txt 2>/dev/null || echo ?) ; failed: $(wc -l < research-evidence/failed.txt 2>/dev/null || echo ?)"
+            cat research-evidence/dossiers/research_index.json 2>/dev/null || echo "INCONCLUSIVE: no research index produced"
+            echo ""
+            echo "Comparator challenges are statements (sorry by design): trust_status STATEMENT_ONLY is expected."
+          } >> "$GITHUB_STEP_SUMMARY"
+      - name: Upload evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: proofscope-research-evidence
+          path: research-evidence/
+          if-no-files-found: warn
+          retention-days: 30
